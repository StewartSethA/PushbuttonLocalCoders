STATE=pathlib.Path(os.environ.get('PUSHBUTTON_RUNTIME_STATE',pathlib.Path.home()/'.local/share/pushbutton/runtime'))
REGISTRY=STATE/'instances.json'
HOP={'connection','keep-alive','proxy-authenticate','proxy-authorization','te','trailers','transfer-encoding','upgrade'}
AUTO_NAMES={'pushbutton/auto','pushbutton/coder','pushbutton/best','auto','local-model'}
SERVED_CACHE={}


def now_iso():return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()
def safe_json(path,default):
    try:return json.loads(path.read_text())
    except Exception:return default

def estimate_tokens(obj):
    # Admission only; text is never persisted. Usage metadata remains authoritative.
    chars=0
    def walk(x):
        nonlocal chars
        if isinstance(x,str):chars+=len(x)
        elif isinstance(x,list):
            for y in x:walk(y)
        elif isinstance(x,dict):
            for k,v in x.items():
                if k not in {'model','stream','temperature','top_p','max_tokens','max_completion_tokens'}:walk(v)
    walk(obj.get('messages') or obj.get('prompt') or '')
    return max(1,round(chars/4))


class Runtime:
    def __init__(self,registry: pathlib.Path,queue_limit=64,queue_timeout=900):
        self.registry=registry; self.queue_limit=queue_limit; self.queue_timeout=queue_timeout
        self.lock=threading.Condition(); self.active={}; self.queued={}; self.failed_until={}; self.maintenance=set(); self._mtime=None; self._instances=[]

    def load(self):
        try:mt=self.registry.stat().st_mtime_ns
        except Exception:mt=None
        if mt!=self._mtime:
            obj=safe_json(self.registry,{})
            rows=obj.get('instances',obj if isinstance(obj,list) else [])
            self._instances=[pool.instance_from_dict(x) for x in rows if isinstance(x,dict)]
            self._mtime=mt
        now=time.time(); out=[]
        for x in self._instances:
            x.active=self.active.get(x.id,0); x.queued=self.queued.get(x.id,0)
            if self.failed_until.get(x.id,0)>now:x.healthy=False
            out.append(x)
        return out

    def models(self):return self.load()

    def _all_candidates(self,model,context):
        rows=self.load()
        if model.lower() in AUTO_NAMES:return pool.auto_candidates(rows,context)
        return sorted([x for x in rows if pool.compatible(x,model,context)],key=lambda x:pool.rank_instance(x,context))

    def _candidates(self,model,context):
        return [x for x in self._all_candidates(model,context) if x.id not in self.maintenance]

    def _queue_wait(self,chosen,queued_id,deadline):
        total_q=sum(self.queued.values())
        if total_q>=self.queue_limit:
            if queued_id:self.queued[queued_id]=max(0,self.queued.get(queued_id,1)-1)
            return queued_id,'REJECT_BUSY'
        if queued_id!=chosen.id:
            if queued_id:self.queued[queued_id]=max(0,self.queued.get(queued_id,1)-1)
            queued_id=chosen.id; self.queued[queued_id]=self.queued.get(queued_id,0)+1
        remain=deadline-time.monotonic()
        if remain<=0:
            self.queued[queued_id]=max(0,self.queued.get(queued_id,1)-1)
            return queued_id,'QUEUE_TIMEOUT'
        self.lock.wait(timeout=min(1.0,remain))
        return queued_id,'WAIT'

    def acquire(self,model,context):
        deadline=time.monotonic()+self.queue_timeout; queued_id=None
        with self.lock:
            while True:
                all_candidates=self._all_candidates(model,context)
                candidates=[x for x in all_candidates if x.id not in self.maintenance]
                if not candidates:
                    maintenance=[x for x in all_candidates if x.id in self.maintenance]
                    if maintenance:
                        queued_id,state=self._queue_wait(maintenance[0],queued_id,deadline)
                        if state=='WAIT':continue
                        return None,state,0
                    if queued_id:self.queued[queued_id]=max(0,self.queued.get(queued_id,1)-1)
                    return None,'NO_COMPATIBLE_INSTANCE',0
                # Prefer any instance with immediate proven capacity.
                chosen=next((x for x in candidates if x.active<x.capacity(context)),candidates[0])
                cap=chosen.capacity(context)
                if chosen.active<cap:
                    if queued_id:self.queued[queued_id]=max(0,self.queued.get(queued_id,1)-1)
                    admitted=self.active.get(chosen.id,0)+1;self.active[chosen.id]=admitted
                    return chosen,'ADMIT',admitted
                queued_id,state=self._queue_wait(chosen,queued_id,deadline)
                if state=='WAIT':continue
                return None,state,0

    def release(self,inst):
        with self.lock:
            self.active[inst.id]=max(0,self.active.get(inst.id,1)-1); self.lock.notify_all()

    def fail_temporarily(self,inst,seconds=15):
        with self.lock:self.failed_until[inst.id]=time.time()+seconds; self.lock.notify_all()

    def acquire_maintenance(self,instance_id):
        """Atomically lease one completely idle instance to the local calibrator."""
        with self.lock:
            rows={x.id:x for x in self.load()}
            if instance_id not in rows:return False,'UNKNOWN_INSTANCE'
            if instance_id in self.maintenance:return True,'ALREADY_HELD'
            if self.active.get(instance_id,0)>0:return False,'ACTIVE'
            if self.queued.get(instance_id,0)>0:return False,'QUEUED'
            self.maintenance.add(instance_id);self.lock.notify_all()
            return True,'ACQUIRED'

    def release_maintenance(self,instance_id):
        with self.lock:
            held=instance_id in self.maintenance
            self.maintenance.discard(instance_id);self.lock.notify_all()
            return held


RUNTIME: Runtime|None=None


def endpoint_parts(endpoint):
    u=urllib.parse.urlparse(endpoint); return u.hostname or '127.0.0.1',u.port or 80,(u.path or '').rstrip('/')
def upstream_path(base,path):
    if base and path.startswith(base+'/'):return path
    return base+path if base else path
def resolve_served_model(inst):
    """Map Pushbutton's stable logical name to the ID exposed by this backend."""
    if inst.served_model:return str(inst.served_model)
    if inst.id in SERVED_CACHE:return SERVED_CACHE[inst.id]
    served=None
    try:
        with urllib.request.urlopen(inst.endpoint.rstrip('/')+'/models',timeout=1.5) as r:o=json.load(r)
        served=str((o.get('data') or [{}])[0].get('id') or '') or None
    except Exception:pass
    served=served or inst.model;SERVED_CACHE[inst.id]=served;return served
def content_event(obj):
    usage=obj.get('usage') or {}; chars=0; seen=False
    for ch in obj.get('choices') or []:
        d=ch.get('delta') or {}; msg=ch.get('message') or {}; txt=d.get('content') or ch.get('text') or msg.get('content')
        if txt:chars+=len(str(txt)); seen=True
    return seen,chars,usage


class Handler(BaseHTTPRequestHandler):
    protocol_version='HTTP/1.1'; server_version='PushbuttonBroker/1'
    def log_message(self,fmt,*args):sys.stderr.write('[pushbutton-broker] '+fmt%args+'\n')
    def json_reply(self,status,obj):
        b=json.dumps(obj).encode();self.send_response(status);self.send_header('Content-Type','application/json');self.send_header('Content-Length',str(len(b)));self.send_header('Connection','close');self.end_headers();self.wfile.write(b);self.close_connection=True
    def json_error(self,status,msg):self.json_reply(status,{'error':{'message':msg,'type':'pushbutton_runtime'}})
    def headers_for_upstream(self,n=None):
        h={k:v for k,v in self.headers.items() if k.lower() not in HOP and k.lower() not in {'host','content-length'}}
        if n is not None:h['Content-Length']=str(n)
        return h
    def local_control_allowed(self):
        return self.client_address[0] in {'127.0.0.1','::1','localhost'}

    def do_GET(self):
        if self.path.rstrip('/')=='/v1/models':
            rows=RUNTIME.models(); data=[]; seen=set()
            for x in rows:
                for name in [x.model,*x.aliases]:
                    if name not in seen:data.append({'id':name,'object':'model','owned_by':'pushbutton'}); seen.add(name)
            data.insert(0,{'id':'pushbutton/auto','object':'model','owned_by':'pushbutton'})
            return self.json_reply(200,{'object':'list','data':data})
        if self.path.rstrip('/')=='/pushbutton/status':
            out=[]
            for x in RUNTIME.models():
                label,warn=x.speed();out.append({
                    'id':x.id,'model':x.model,'backend':x.backend,'active':x.active,'queued':x.queued,
                    'capacity':x.capacity(x.context_limit()),'framework_max_concurrency':x.framework_max_concurrency or 1,
                    'context_limit':x.context_limit(),'maintenance':x.id in RUNTIME.maintenance,
                    'speed':label,'tg':x.tg,'warning':warn})
            return self.json_reply(200,{'instances':out})
        self.json_error(404,'unknown broker endpoint')

    def do_POST(self):
        n=int(self.headers.get('Content-Length') or 0); body=self.rfile.read(n) if n else b'{}'
        try:obj=json.loads(body)
        except Exception:return self.json_error(400,'request body must be JSON')
        path=self.path.rstrip('/')
        if path in {'/pushbutton/maintenance/acquire','/pushbutton/maintenance/release'}:
            if not self.local_control_allowed():return self.json_error(403,'maintenance control is loopback-only')
            iid=str(obj.get('id') or '')
            if not iid:return self.json_error(400,'instance id is required')
            if path.endswith('/acquire'):
                ok,reason=RUNTIME.acquire_maintenance(iid)
                return self.json_reply(200 if ok else 409,{'ok':ok,'reason':reason,'id':iid})
            held=RUNTIME.release_maintenance(iid)
            return self.json_reply(200,{'ok':True,'released':held,'id':iid})
        model=str(obj.get('model') or 'pushbutton/auto'); prompt_tokens=estimate_tokens(obj); out_budget=int(obj.get('max_tokens') or obj.get('max_completion_tokens') or 4096); needed=prompt_tokens+out_budget
        inst,decision,admitted_concurrency=RUNTIME.acquire(model,needed)
        if not inst:
            code=429 if decision in {'REJECT_BUSY','QUEUE_TIMEOUT'} else 503
            return self.json_error(code,f'{decision}: no resident configuration can safely serve model={model!r} at about {needed:,} tokens')
        try:self.forward(inst,obj,prompt_tokens,admitted_concurrency)
        finally:RUNTIME.release(inst)

    def forward(self,inst,obj,prompt_est,admitted_concurrency):
        host,port,base=endpoint_parts(inst.endpoint); conn=http.client.HTTPConnection(host,port,timeout=3600); start=time.perf_counter(); first=None; usage={}; chars=0
        upstream_obj=dict(obj);upstream_obj['model']=resolve_served_model(inst);body=json.dumps(upstream_obj,separators=(',',':')).encode()
        try:
            conn.request('POST',upstream_path(base,self.path),body=body,headers=self.headers_for_upstream(len(body))); r=conn.getresponse()
        except Exception as exc:
            conn.close(); RUNTIME.fail_temporarily(inst); return self.json_error(502,f'backend {inst.id} unavailable: {exc}')
        label,warn=inst.speed(); ctype=(r.getheader('Content-Type') or '').lower(); stream='text/event-stream' in ctype
        self.send_response(r.status,r.reason)
        for k,v in r.getheaders():
            if k.lower() not in HOP and k.lower()!='content-length':self.send_header(k,v)
        if warn:self.send_header('X-Pushbutton-Speed-Warning',warn[:240]); sys.stderr.write('[pushbutton-broker] WARNING: '+warn+'\n')
        if stream:self.send_header('Connection','close'); self.end_headers()
        if stream:
            while True:
                line=r.readline()
                if not line:break
                self.wfile.write(line); self.wfile.flush()
                if not line.startswith(b'data:'):continue
                d=line[5:].strip()
                if not d or d==b'[DONE]':continue
                try:o=json.loads(d)
                except Exception:continue
                seen,add,u=content_event(o); chars+=add
                if seen and first is None:first=time.perf_counter()
                if u:usage=u
        else:
            data=r.read(); end_read=time.perf_counter()
            try:o=json.loads(data); usage=o.get('usage') or {}; seen,add,_=content_event(o); chars+=add; first=end_read if seen else None
            except Exception:chars=len(data)
            self.send_header('Content-Length',str(len(data))); self.send_header('Connection','close'); self.end_headers(); self.wfile.write(data)
        end=time.perf_counter(); conn.close(); self.close_connection=True
        if self.path.endswith('/chat/completions') or self.path.endswith('/completions'):
            try:self.record(inst,start,first,end,usage,prompt_est,chars,r.status,admitted_concurrency)
            except Exception as exc:self.log_message('metric recording skipped: %s',exc)

    def record(self,inst,start,first,end,usage,prompt_est,chars,status,admitted_concurrency):
        pt=usage.get('prompt_tokens') or usage.get('input_tokens') or prompt_est; ct=usage.get('completion_tokens') or usage.get('output_tokens') or max(1,round(chars/4)); ttft=(first-start) if first else None
        obs={'schema_version':1,'timestamp_utc':now_iso(),'model':inst.model,'backend':inst.backend,'artifact':inst.artifact,'context':inst.context_limit(),'prompt_tokens':pt,'completion_tokens':ct,'pp':(pt/ttft if ttft else None),'tg':((ct-1)/(end-first) if first and end>first and ct>1 else None),'ttft':ttft,'elapsed_s':end-start,'concurrency':max(1,int(admitted_concurrency)),'source':'normal-use','method':'broker','status_code':status}
        metrics.save_observation(obs); metrics.queue_observation(obs); metrics.maybe_upload()


def start_background(script_name,host,port,registry,log_name):
    """Start one best-effort runtime worker; each worker owns its own singleton lock."""
    script=ROOT/script_name
    if not script.exists():return None
    log=STATE/f'logs/{log_name}.log';log.parent.mkdir(parents=True,exist_ok=True);f=log.open('ab',buffering=0)
    connect_host='127.0.0.1' if host in {'0.0.0.0','::',''} else host
    try:
        return subprocess.Popen(
            [sys.executable,str(script),'--broker',f'http://{connect_host}:{port}','--registry',str(registry)],
            stdout=f,stderr=subprocess.STDOUT,start_new_session=True,env=os.environ.copy())
    except Exception as exc:
        print(f'[pushbutton-broker] {script_name} disabled harmlessly: {exc}',file=sys.stderr);return None


def main():
    global RUNTIME
    ap=argparse.ArgumentParser(prog='pushbutton-broker')
    ap.add_argument('--host',default='127.0.0.1');ap.add_argument('--port',type=int,default=19780)
    ap.add_argument('--registry',type=pathlib.Path,default=REGISTRY);ap.add_argument('--queue-limit',type=int,default=64)
    ap.add_argument('--queue-timeout',type=int,default=900);ap.add_argument('--no-scaler',action='store_true');ap.add_argument('--no-calibrator',action='store_true')
    a=ap.parse_args()
    a.registry.parent.mkdir(parents=True,exist_ok=True)
    if not a.registry.exists():a.registry.write_text('{"instances":[]}\n')
    RUNTIME=Runtime(a.registry,a.queue_limit,a.queue_timeout);s=ThreadingHTTPServer((a.host,a.port),Handler);workers=[]
    if not a.no_scaler:workers.append(start_background('pushbutton-scaler',a.host,a.port,a.registry,'scaler'))
    if not a.no_calibrator:workers.append(start_background('pushbutton-calibrate',a.host,a.port,a.registry,'calibrator'))
    print(f'[pushbutton-broker] http://{a.host}:{a.port}/v1  registry={a.registry}',file=sys.stderr,flush=True)
    try:s.serve_forever()
    except KeyboardInterrupt:pass
    finally:
        s.server_close();metrics.maybe_upload(force=True)
        for w in workers:
            if w and w.poll() is None:
                try:w.terminate()
                except Exception:pass

if __name__=='__main__':main()
