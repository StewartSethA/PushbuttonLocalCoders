#!/usr/bin/env bash
# claude-local — Pushbutton local-model harness for Claude Code.
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
command -v readlink >/dev/null 2>&1 && SELF="$(readlink -f "$SELF" 2>/dev/null || printf '%s' "$SELF")"
ROOT="$(cd "$(dirname "$SELF")" && pwd)"
LIB="$ROOT/lib"
PLAN_PY="$LIB/claude_local_plan.py"
GATEWAY_PY="$LIB/claude_local_gateway.py"

STATE_DIR="${CLAUDE_LOCAL_STATE:-$HOME/.local/share/pushbutton/claude-local}"
CACHE_DIR="${CLAUDE_LOCAL_CACHE:-$HOME/.cache/pushbutton/llama}"
LOCK_FILE="${CLAUDE_LOCAL_LOCK_FILE:-$HOME/.local/share/pushbutton/claude-local/startup.lock}"
CTX="${CLAUDE_LOCAL_CONTEXT:-262144}"
CLIENT_CTX="${CLAUDE_LOCAL_CLIENT_CONTEXT:-200000}"
PORT_BASE="${CLAUDE_LOCAL_PORT_BASE:-18180}"
ALLOW_OFFLOAD=0
KEEP_SERVERS=0
ENABLE_TEAMS=1
DRY_RUN=0
VERBOSE=0
MODELS=()
CLAUDE_ARGS=()
PIDS=()
STARTUP_LOCK_FD=""

say() { printf '\033[1;34m[claude-local]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[claude-local]\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31m[claude-local]\033[0m %s\n' "$*" >&2; exit 1; }
have_cmd() { command -v "$1" >/dev/null 2>&1; }

usage() {
cat <<'EOF'
Usage:
  claude-local [MODEL [MODEL [MODEL [MODEL]]]] [Claude Code flags...]
  claude-local install [--system]
  claude-local doctor
  claude-local models

Model order:
  1 model : Haiku = Sonnet = Opus = Fable
  2 models: Haiku = #1, Sonnet/Opus/Fable = #2
  3 models: Haiku = #1, Sonnet = #2, Opus/Fable = #3
  4 models: Haiku, Sonnet, Opus, Fable respectively

Built-ins: nemotron-3.5-lightning qwen3.6:35b qwen3.8:27b glm-5.3-flash

Harness options (put before ordinary Claude Code flags):
  --local-cache DIR          llama.cpp/Hugging Face model cache
  --local-context N          physical backend context (default 262144)
  --local-client-context N   Claude Code budget (default 200000)
  --local-port-base N        starting port for gateway/backends
  --local-no-teams           disable experimental Claude agent teams
  --local-keep-servers       leave model servers running after Claude exits
  --local-allow-offload      allow CUDA unified-memory spill (slow; default off)
  --local-dry-run            show hardware/model plan only
  --local-verbose            verbose local gateway logging
  --                         stop harness parsing; pass rest to Claude Code

All ordinary Claude Code flags, including --resume/--continue/--permission-mode,
are passed through unchanged.
EOF
}

require_files() {
    [[ -f "$PLAN_PY" ]] || die "missing $PLAN_PY"
    [[ -f "$GATEWAY_PY" ]] || die "missing $GATEWAY_PY"
}

base_deps_missing() {
    local -a missing=()
    local c
    for c in git cmake ninja python3 curl tar cc c++ lspci flock; do
        have_cmd "$c" || missing+=("$c")
    done
    if ! have_cmd pkg-config; then
        missing+=("pkg-config")
    elif ! pkg-config --exists openssl 2>/dev/null; then
        missing+=("OpenSSL-development-files")
    fi
    if ((${#missing[@]})); then
        printf '%s\n' "${missing[@]}"
    fi
    return 0
}

apt_update_best_effort() {
    if ! sudo apt-get update; then
        warn "apt-get update reported errors (often an unrelated third-party repository); continuing with usable/cached package indexes."
    fi
    return 0
}

install_base_deps() {
    local before after
    before="$(base_deps_missing)"
    [[ -z "$before" ]] && return 0

    say "Installing missing build/runtime dependencies..."
    if have_cmd apt-get; then
        apt_update_best_effort
        if ! sudo apt-get install -y build-essential cmake ninja-build git curl ca-certificates libssl-dev python3 python3-venv bzip2 xz-utils pkg-config pciutils util-linux; then
            warn "apt-get install reported an error; verifying the dependencies claude-local actually needs before deciding whether to stop."
        fi
    elif have_cmd dnf; then
        if ! sudo dnf install -y gcc gcc-c++ cmake ninja-build git curl openssl-devel python3 bzip2 xz pkgconf-pkg-config pciutils util-linux; then
            warn "dnf reported an error; verifying the dependencies claude-local actually needs before deciding whether to stop."
        fi
    else
        die "required dependencies are missing and automatic installation currently supports apt or dnf hosts"
    fi

    after="$(base_deps_missing)"
    if [[ -n "$after" ]]; then
        die "required dependencies are still missing after the package-manager attempt: $(printf '%s' "$after" | tr '\n' ' '). Unrelated repository errors are ignored; install only these missing prerequisites and rerun."
    fi
}

ensure_nvidia_driver() {
    have_cmd nvidia-smi && nvidia-smi >/dev/null 2>&1 && return 0
    have_cmd lspci && lspci -nn 2>/dev/null | grep -qi NVIDIA || die "no working NVIDIA GPU/driver detected"
    if have_cmd apt-get && grep -qi '^ID=ubuntu' /etc/os-release 2>/dev/null; then
        say "Installing Ubuntu's recommended NVIDIA driver..."
        apt_update_best_effort
        if ! sudo apt-get install -y ubuntu-drivers-common; then
            warn "apt-get could not cleanly install ubuntu-drivers-common; checking whether the required command is nevertheless available."
        fi
        have_cmd ubuntu-drivers || die "ubuntu-drivers is unavailable after the package-manager attempt"
        if ! sudo ubuntu-drivers install; then
            warn "ubuntu-drivers reported an error; checking whether an NVIDIA driver became usable anyway."
        fi
        nvidia-smi >/dev/null 2>&1 || die "NVIDIA driver is not active; if it was just installed, reboot once and rerun the same command"
        return 0
    fi
    die "NVIDIA hardware exists but nvidia-smi is unavailable; install/load the NVIDIA driver and rerun"
}

install_claude_code() {
    have_cmd claude && return 0
    say "Claude Code not found; installing it..."
    if curl -fsSL https://claude.ai/install.sh | bash; then export PATH="$HOME/.local/bin:$PATH"; fi
    have_cmd claude && return 0
    if ! have_cmd npm; then
        have_cmd apt-get && sudo apt-get install -y nodejs npm || true
        have_cmd dnf && sudo dnf install -y nodejs npm || true
    fi
    have_cmd npm || die "could not install Claude Code"
    npm install -g @anthropic-ai/claude-code
    have_cmd claude || die "Claude Code installed but is not in PATH"
}

install_command() {
    local dst
    if [[ "${1:-}" == --system ]]; then
        dst=/usr/local/bin/claude-local
        sudo ln -sfn "$SELF" "$dst"
    else
        mkdir -p "$HOME/.local/bin"
        dst="$HOME/.local/bin/claude-local"
        ln -sfn "$SELF" "$dst"
    fi
    say "Installed command: $dst"
}

free_port() {
python3 - "$1" <<'PY'
import socket,sys
for p in range(int(sys.argv[1]), min(65535,int(sys.argv[1])+200)):
    s=socket.socket()
    try: s.bind(('127.0.0.1',p)); print(p); raise SystemExit
    except OSError: pass
    finally: s.close()
raise SystemExit(1)
PY
}

acquire_startup_lock() {
    mkdir -p "$(dirname "$LOCK_FILE")"
    exec {STARTUP_LOCK_FD}>"$LOCK_FILE"
    if ! flock -n "$STARTUP_LOCK_FD"; then
        say "Another claude-local instance is allocating GPUs/ports; waiting for it to finish startup..."
        flock "$STARTUP_LOCK_FD"
    fi
}

release_startup_lock() {
    [[ -n "${STARTUP_LOCK_FD:-}" ]] || return 0
    flock -u "$STARTUP_LOCK_FD" 2>/dev/null || true
    exec {STARTUP_LOCK_FD}>&- 2>/dev/null || true
    STARTUP_LOCK_FD=""
}

inventory_arches() {
python3 - "$PLAN_FILE" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); a=[]
for s in p['servers']:
  for g in s['gpus']:
    cc=g.get('compute_cap','').replace('.','')
    if cc and cc not in a: a.append(cc)
print(';'.join(sorted(a,key=int)))
PY
}

needs_legacy_cuda() {
python3 - "$PLAN_FILE" <<'PY'
import json,sys
for s in json.load(open(sys.argv[1]))['servers']:
  for g in s['gpus']:
    try:
      if float(g.get('compute_cap') or 99)<7.5: raise SystemExit(0)
    except ValueError: pass
raise SystemExit(1)
PY
}

bootstrap_micromamba() {
    local mm="$STATE_DIR/bin/micromamba"
    if [[ -x "$mm" ]]; then printf '%s\n' "$mm"; return; fi
    mkdir -p "$STATE_DIR/bin"
    say "Bootstrapping micromamba..." >&2
    curl -fsSL https://micro.mamba.pm/api/micromamba/linux-64/latest | tar -xj -C "$STATE_DIR/bin" --strip-components=1 bin/micromamba
    chmod +x "$mm"; printf '%s\n' "$mm"
}

activate_cuda() {
    local desired=12.9.2 legacy=0 system_ok=0 nvcc_ver=""
    if needs_legacy_cuda; then desired=12.8.2; legacy=1; fi
    if have_cmd nvcc; then
        nvcc_ver="$(nvcc --version | sed -n 's/.*release \([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p' | tail -1)"
        [[ $legacy -eq 1 && "$nvcc_ver" == 12.8* ]] && system_ok=1
        [[ $legacy -eq 0 && ( "$nvcc_ver" == 12.* || "$nvcc_ver" == 13.* ) ]] && system_ok=1
    fi
    if [[ $system_ok -eq 1 ]]; then
        say "Using existing nvcc CUDA $nvcc_ver"; export CUDACXX="$(command -v nvcc)"; return
    fi
    local prefix="$STATE_DIR/cuda-$desired" mm
    mm="$(bootstrap_micromamba)"
    if [[ ! -x "$prefix/bin/nvcc" ]]; then
        say "Installing private CUDA Toolkit $desired (driver untouched)..."
        MAMBA_ROOT_PREFIX="$STATE_DIR/micromamba-root" "$mm" create -y -p "$prefix" -c nvidia -c conda-forge "cuda-minimal-build=$desired" libcublas-dev
    fi
    export CUDA_HOME="$prefix" CUDA_PATH="$prefix" CUDA_ROOT="$prefix" CUDACXX="$prefix/bin/nvcc"
    export PATH="$prefix/bin:$PATH"
    export LD_LIBRARY_PATH="$prefix/lib:$prefix/lib64:${LD_LIBRARY_PATH:-}"
    export LIBRARY_PATH="$prefix/lib:$prefix/lib64:${LIBRARY_PATH:-}"
    export CPATH="$prefix/include:${CPATH:-}"
}

build_kind() {
python3 - "$PLAN_FILE" <<'PY'
import json,sys
print('glm53' if any(s['profile']['build']=='glm53' for s in json.load(open(sys.argv[1]))['servers']) else 'upstream')
PY
}

ensure_llamacpp() {
    local kind arches src build repo ref
    kind="$(build_kind)"; arches="$(inventory_arches)"; [[ -n "$arches" ]] || arches=native
    if [[ "$kind" == glm53 ]]; then
        src="$STATE_DIR/llama.cpp-glm53"; repo=https://github.com/unslothai/llama.cpp.git; ref=glm5next/upstream
    else
        src="$STATE_DIR/llama.cpp"; repo=https://github.com/ggml-org/llama.cpp.git; ref=master
    fi
    build="$src/build-cuda-${arches//;/_}"; LLAMA_SERVER="$build/bin/llama-server"
    [[ -x "$LLAMA_SERVER" && "${CLAUDE_LOCAL_REBUILD:-0}" != 1 ]] && { say "Using existing CUDA llama.cpp: $LLAMA_SERVER"; return; }
    if [[ -d "$src/.git" ]]; then
        say "Updating llama.cpp ($kind)..."
        git -C "$src" fetch --depth=1 origin "$ref:refs/remotes/origin/$ref"
        git -C "$src" checkout -q "$ref" 2>/dev/null || git -C "$src" checkout -q -B "$ref" "origin/$ref"
        git -C "$src" reset --hard "origin/$ref"
    else
        say "Cloning llama.cpp ($kind)..."; git clone --depth=1 --branch "$ref" "$repo" "$src"
    fi
    local -a cmake_args=(-DGGML_CUDA=ON -DGGML_CUDA_FA_ALL_QUANTS=ON -DGGML_CUDA_PEER_MAX_BATCH_SIZE=8192 -DLLAMA_OPENSSL=ON -DCMAKE_BUILD_TYPE=Release "-DCMAKE_CUDA_ARCHITECTURES=$arches")
    [[ -n "${CUDA_ROOT:-}" ]] && cmake_args+=("-DCMAKE_CUDA_COMPILER=$CUDA_ROOT/bin/nvcc" "-DCUDAToolkit_ROOT=$CUDA_ROOT")
    say "Building CUDA llama.cpp for SM: $arches"
    cmake -S "$src" -B "$build" -G Ninja "${cmake_args[@]}"
    cmake --build "$build" --target llama-server llama-bench -j"$(nproc)"
    [[ -x "$LLAMA_SERVER" ]] || die "CUDA llama-server build failed"
}

fetch_qwen_template() {
    QWEN_TEMPLATE="$STATE_DIR/templates/qwen-fixed.jinja"; mkdir -p "$(dirname "$QWEN_TEMPLATE")"
    if [[ ! -s "$QWEN_TEMPLATE" || "${CLAUDE_LOCAL_REFRESH_TEMPLATE:-0}" == 1 ]]; then
        say "Downloading fixed Qwen agent/tool template..."
        curl -fsSL https://huggingface.co/froggeric/Qwen-Fixed-Chat-Templates/resolve/main/chat_template.jinja -o "$QWEN_TEMPLATE.new"
        mv "$QWEN_TEMPLATE.new" "$QWEN_TEMPLATE"
    fi
}

cleanup() {
    release_startup_lock
    [[ $KEEP_SERVERS -eq 1 ]] && return 0
    local p
    for p in "${PIDS[@]:-}"; do kill "$p" 2>/dev/null || true; done
}
trap cleanup EXIT INT TERM

server_rows() {
python3 - "$PLAN_FILE" <<'PY'
import json,sys
sep='\x1f'
for s in json.load(open(sys.argv[1]))['servers']:
 x=s['profile']; env=';'.join(f'{k}={v}' for k,v in x.get('extra_env',{}).items())
 print(sep.join(map(str,[s['id'],x['hf_spec'],s['cuda_visible_devices'],int(s['multi_gpu']),x['kv_k'],x['kv_v'],x['batch'],x['ubatch'],x['flash_attn'],x['template'],env,x.get('note','')])))
PY
}

role_rows() {
python3 - "$PLAN_FILE" <<'PY'
import json,sys
p=json.load(open(sys.argv[1]));
for r in ('haiku','sonnet','opus','fable'): print(r+'\t'+p['role_ids'][r])
PY
}

start_backends() {
    mkdir -p "$STATE_DIR/logs" "$CACHE_DIR"; export LLAMA_CACHE="$CACHE_DIR" GGML_CUDA_ENABLE_UNIFIED_MEMORY="$ALLOW_OFFLOAD" CUDA_SCALE_LAUNCH_QUEUES=4x
    local next=$((PORT_BASE+1)); BACKENDS_TSV="$STATE_DIR/backends.$$"; : > "$BACKENDS_TSV"
    while IFS=$'\x1f' read -r id hf gpus multi kvk kvv batch ubatch fa template envpairs note; do
        local port log pid failed=0; port="$(free_port "$next")"; next=$((port+1)); log="$STATE_DIR/logs/${id}.log"
        local -a cmd=("$LLAMA_SERVER" -hf "$hf" --alias "$id" --no-mmproj -ngl 999 -c "$CTX" -np 1 --cache-type-k "$kvk" --cache-type-v "$kvv" -b "$batch" -ub "$ubatch" -fa "$fa" --jinja --no-context-shift --host 127.0.0.1 --port "$port")
        [[ "$multi" == 1 ]] && cmd+=(--split-mode layer)
        [[ "$template" == qwen-fixed ]] && cmd+=(--chat-template-file "$QWEN_TEMPLATE")
        local -a envcmd=(env "CUDA_VISIBLE_DEVICES=$gpus" "LLAMA_CACHE=$CACHE_DIR" "GGML_CUDA_ENABLE_UNIFIED_MEMORY=$ALLOW_OFFLOAD" "CUDA_SCALE_LAUNCH_QUEUES=4x")
        if [[ -n "$envpairs" ]]; then local -a pairs; IFS=';' read -ra pairs <<< "$envpairs"; local pair; for pair in "${pairs[@]}"; do envcmd+=("$pair"); done; fi
        say "Starting $id on GPU(s) [$gpus], $hf, ctx=$CTX${note:+ — $note}"
        "${envcmd[@]}" "${cmd[@]}" >"$log" 2>&1 & pid=$!; PIDS+=("$pid")
        while ! curl -fsS "http://127.0.0.1:$port/health" >/dev/null 2>&1; do kill -0 "$pid" 2>/dev/null || { failed=1; break; }; sleep 2; done
        [[ $failed -eq 0 ]] || { tail -80 "$log" >&2 || true; die "failed to start $id"; }
        printf '%s\t%s\t%s\n' "$id" "$port" "$hf" >> "$BACKENDS_TSV"
    done < <(server_rows)
}

write_gateway_config() {
    GATEWAY_CONFIG="$STATE_DIR/gateway.$$.json"
python3 - "$PLAN_FILE" "$BACKENDS_TSV" "$GATEWAY_CONFIG" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); ports={}
for line in open(sys.argv[2]):
 mid,port,*_=line.rstrip('\n').split('\t'); ports[mid]=int(port)
roles={r:{'model_id':mid,'backend_alias':mid,'url':f'http://127.0.0.1:{ports[mid]}'} for r,mid in p['role_ids'].items()}
json.dump({'roles':roles},open(sys.argv[3],'w'),indent=2)
PY
}

start_gateway() {
    GATEWAY_PORT="$(free_port "$PORT_BASE")"; local log="$STATE_DIR/logs/gateway.log" pid; local -a extra=(); [[ $VERBOSE -eq 1 ]] && extra+=(--verbose)
    python3 "$GATEWAY_PY" --config "$GATEWAY_CONFIG" --port "$GATEWAY_PORT" "${extra[@]}" >"$log" 2>&1 & pid=$!; PIDS+=("$pid")
    while ! curl -fsS "http://127.0.0.1:$GATEWAY_PORT/health" >/dev/null 2>&1; do kill -0 "$pid" 2>/dev/null || { tail -80 "$log" >&2 || true; die "local gateway failed"; }; sleep 1; done
}

contains_claude_flag() { local w="$1" x; for x in "${CLAUDE_ARGS[@]:-}"; do [[ "$x" == "$w" || "$x" == "$w="* ]] && return 0; done; return 1; }

agents_json() {
python3 - "$PLAN_FILE" <<'PY'
import json,sys
ids=json.load(open(sys.argv[1]))['role_ids']
out={
'local-fast':{'description':'Fast repository reconnaissance, search, triage, and bounded subtasks.','prompt':'Work quickly and concretely. Inspect the repository, gather facts, run relevant read-only checks, and return concise actionable findings.','model':ids['haiku']},
'local-coder':{'description':'Implementation work that can be delegated independently or in parallel.','prompt':'Implement the assigned coding task completely. Inspect relevant code first, make minimal coherent changes, run focused tests, and report files changed and remaining risks.','model':ids['sonnet']},
'local-reviewer':{'description':'Independent correctness, regression, security, and test review.','prompt':'Review changes independently. Find correctness bugs, edge cases, security/concurrency hazards, compatibility problems, and missing tests. Prioritize findings.','model':ids['opus']},
'local-deep':{'description':'Difficult architecture, debugging, root-cause analysis, or a second solution path.','prompt':'Solve the hard problem from first principles. Inspect evidence, test assumptions, compare approaches, and return a rigorous implementation path.','model':ids['fable']}}
print(json.dumps(out,separators=(',',':')))
PY
}

print_plan() {
python3 - "$PLAN_FILE" <<'PY'
import json,sys
p=json.load(open(sys.argv[1])); print(f"Physical context: {p['context']:,}\nClaude roles:")
for r in ('haiku','sonnet','opus','fable'): print(f"  {r:6} -> {p['roles'][r]} ({p['role_ids'][r]})")
print('Servers:')
for s in p['servers']:
 x=s['profile']; gs=', '.join(f"GPU{g['index']} {g['name']} ({g['free_mib']/1024:.1f} GiB free, PCIe Gen{g['pcie_gen']} x{g['pcie_width']})" for g in s['gpus'])
 print(f"  {s['id']}: {x['hf_spec']}\n    {gs}\n    KV={x['kv_k']}/{x['kv_v']} batch={x['batch']}/{x['ubatch']} FA={x['flash_attn']} quality-tier={x['quality']}")
PY
}

run_claude() {
    local key="claude-local-$RANDOM-$$" role id sonnet_id
    export ANTHROPIC_BASE_URL="http://127.0.0.1:$GATEWAY_PORT" ANTHROPIC_AUTH_TOKEN="$key" ANTHROPIC_API_KEY="$key" CLAUDE_CODE_MAX_CONTEXT_TOKENS="$CLIENT_CTX"
    unset CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY ANTHROPIC_BEDROCK_BASE_URL ANTHROPIC_VERTEX_BASE_URL || true
    while IFS=$'\t' read -r role id; do
        case "$role" in
          haiku) export ANTHROPIC_DEFAULT_HAIKU_MODEL="$id";;
          sonnet) export ANTHROPIC_DEFAULT_SONNET_MODEL="$id" ANTHROPIC_DEFAULT_MODEL="$id" ANTHROPIC_MODEL="$id";;
          opus) export ANTHROPIC_DEFAULT_OPUS_MODEL="$id";;
          fable) export ANTHROPIC_DEFAULT_FABLE_MODEL="$id";;
        esac
    done < <(role_rows)
    [[ $ENABLE_TEAMS -eq 1 ]] && export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1 || unset CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS || true
    sonnet_id="$(python3 - "$PLAN_FILE" <<'PY'
import json,sys
print(json.load(open(sys.argv[1]))['role_ids']['sonnet'])
PY
)"
    local -a args=("${CLAUDE_ARGS[@]}")
    contains_claude_flag --model || args=(--model "$sonnet_id" "${args[@]}")
    contains_claude_flag --agents || args=(--agents "$(agents_json)" "${args[@]}")
    say "Claude Code -> local gateway http://127.0.0.1:$GATEWAY_PORT (no cloud fallback)"
    claude "${args[@]}"
}

doctor() {
    say "Repository: $ROOT"; say "State: $STATE_DIR"; say "Cache: $CACHE_DIR"
    have_cmd nvidia-smi && nvidia-smi --query-gpu=index,name,memory.total,memory.free,compute_cap,pcie.link.gen.current,pcie.link.width.current --format=csv,noheader 2>/dev/null || warn "nvidia-smi unavailable"
    have_cmd nvcc && nvcc --version | tail -4 || warn "nvcc unavailable (bootstrapped on first run)"
    have_cmd claude && claude --version || warn "Claude Code unavailable (installed on first run)"
}

require_files
case "${1:-}" in
  help|-h|--help) usage; exit 0;;
  install) shift; install_base_deps; install_claude_code; install_command "${1:-}"; exit 0;;
  doctor) doctor; exit 0;;
  models) python3 "$PLAN_PY" catalogue; exit 0;;
esac

while (($#)); do
    case "$1" in
      --) shift; CLAUDE_ARGS+=("$@"); break;;
      --local-cache) [[ $# -ge 2 ]] || die "--local-cache needs a directory"; CACHE_DIR="$2"; shift 2;;
      --local-context) CTX="$2"; shift 2;;
      --local-client-context) CLIENT_CTX="$2"; shift 2;;
      --local-port-base) PORT_BASE="$2"; shift 2;;
      --local-no-teams) ENABLE_TEAMS=0; shift;;
      --local-keep-servers) KEEP_SERVERS=1; shift;;
      --local-allow-offload) ALLOW_OFFLOAD=1; shift;;
      --local-dry-run) DRY_RUN=1; shift;;
      --local-verbose) VERBOSE=1; shift;;
      -*) CLAUDE_ARGS+=("$@"); break;;
      *) MODELS+=("$1"); shift;;
    esac
done

[[ "$CTX" =~ ^[0-9]+$ && "$CLIENT_CTX" =~ ^[0-9]+$ ]] || die "context values must be integers"
(( CLIENT_CTX <= CTX )) || die "client context ($CLIENT_CTX) exceeds physical context ($CTX)"
if [[ $DRY_RUN -eq 0 ]]; then install_base_deps; ensure_nvidia_driver; else have_cmd nvidia-smi || die "nvidia-smi required for dry run"; fi
mkdir -p "$STATE_DIR" "$CACHE_DIR"; PLAN_FILE="$STATE_DIR/plan.$$.json"

# Serialize only startup/allocation. Existing sessions remain concurrent, but a
# second launch cannot observe the same free VRAM/port state and race the first.
[[ $DRY_RUN -eq 0 ]] && acquire_startup_lock
plan_args=(plan --context "$CTX"); if ((${#MODELS[@]})); then plan_args+=("${MODELS[@]}"); else plan_args+=(--smart); fi
python3 "$PLAN_PY" "${plan_args[@]}" > "$PLAN_FILE" || exit $?
print_plan; [[ $DRY_RUN -eq 1 ]] && exit 0
install_claude_code; activate_cuda; ensure_llamacpp
grep -q '"template": "qwen-fixed"' "$PLAN_FILE" && fetch_qwen_template || true
start_backends; write_gateway_config; start_gateway
release_startup_lock
run_claude
