#!/usr/bin/env python3
"""Transparent OpenAI-compatible proxy that profiles normal Pushbutton traffic.

It forwards request/response bodies without storing them. Only compact timing,
token-count and hardware/backend metadata is persisted via pushbutton_metrics.
"""
from __future__ import annotations
import argparse, datetime as dt, http.client, json, pathlib, sys, time, urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

ROOT=pathlib.Path(__file__).resolve().parent
sys.path.insert(0,str(ROOT/'lib'))
import pushbutton_metrics as metrics

HOP={"connection","keep-alive","proxy-authenticate","proxy-authorization","te","trailers","transfer-encoding","upgrade"}


def now_iso():
    return dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()


def content_event(obj: dict) -> tuple[bool,int,dict]:
    usage=obj.get("usage") or {}
    chars=0; seen=False
    for ch in obj.get("choices") or []:
        delta=ch.get("delta") or {}
        text=delta.get("content")
        if text:
            chars+=len(str(text)); seen=True
        text=ch.get("text")
        if text:
            chars+=len(str(text)); seen=True
    return seen,chars,usage


class Proxy:
    def __init__(self,args):
        u=urllib.parse.urlparse(args.upstream)
        self.host=u.hostname or "127.0.0.1"; self.port=u.port or 80
        self.base=(u.path or "").rstrip("/")
        self.model=args.model; self.backend=args.backend; self.artifact=args.artifact
        self.context=args.context; self.gpu_models=args.gpu_model or []
        self.gpu_memory=args.gpu_memory_mib or []
        self.ram_gib=args.ram_gib

    def record(self,*,start,first,end,usage,req_bytes,out_chars,status,source):
        pt=usage.get("prompt_tokens") or usage.get("input_tokens")
        ct=usage.get("completion_tokens") or usage.get("output_tokens")
        pt_est=False; ct_est=False
        if not pt:
            # We deliberately do not parse/store the prompt. Byte count is enough for
            # a rough local SLA bin when a backend omits usage metadata.
            pt=max(1,round(req_bytes/4)); pt_est=True
        if not ct:
            ct=max(1,round(out_chars/4)); ct_est=True
        ttft=(first-start) if first else None; elapsed=end-start
        pp=(pt/ttft) if pt and ttft and ttft>0 else None
        tg=((ct-1)/(end-first)) if first and end>first and ct and ct>1 else None
        obs={
            "schema_version":1,"timestamp_utc":now_iso(),"model":self.model,"backend":self.backend,
            "artifact":self.artifact,"context":self.context,"gpu_models":self.gpu_models,
            "gpu_memory_mib":self.gpu_memory,"ram_gib":self.ram_gib,"prompt_tokens":pt,
            "completion_tokens":ct,"prompt_tokens_estimated":pt_est,"completion_tokens_estimated":ct_est,
            "pp":pp,"tg":tg,"ttft":ttft,"elapsed_s":elapsed,"concurrency":1,
            "source":source,"method":"openai-proxy","status_code":status,
        }
        metrics.save_observation(obs); metrics.queue_observation(obs); metrics.maybe_upload()


PROXY: Proxy | None=None


class Handler(BaseHTTPRequestHandler):
    protocol_version="HTTP/1.1"
    server_version="PushbuttonProxy/1"
    def log_message(self,fmt,*args):
        if getattr(self.server,"quiet",False):return
        sys.stderr.write("[pushbutton-proxy] "+fmt%args+"\n")

    def _conn(self):return http.client.HTTPConnection(PROXY.host,PROXY.port,timeout=3600)
    def _path(self):return (PROXY.base+self.path) if PROXY.base else self.path
    def _headers(self,body_len=None):
        h={k:v for k,v in self.headers.items() if k.lower() not in HOP and k.lower() not in {"host","content-length","x-pushbutton-source"}}
        if body_len is not None:h["Content-Length"]=str(body_len)
        return h

    def _relay_headers(self,r,stream=False):
        self.send_response(r.status,r.reason)
        for k,v in r.getheaders():
            lk=k.lower()
            if lk in HOP or lk=="content-length" or (stream and lk=="content-encoding"):continue
            self.send_header(k,v)
        self.send_header("Connection","close")
        self.end_headers()

    def do_GET(self):
        c=self._conn()
        try:
            c.request("GET",self._path(),headers=self._headers()); r=c.getresponse(); data=r.read()
            self.send_response(r.status,r.reason)
            for k,v in r.getheaders():
                if k.lower() not in HOP and k.lower()!="content-length":self.send_header(k,v)
            self.send_header("Content-Length",str(len(data))); self.send_header("Connection","close"); self.end_headers(); self.wfile.write(data)
        finally:c.close(); self.close_connection=True

    def do_POST(self):
        n=int(self.headers.get("Content-Length") or 0); body=self.rfile.read(n) if n else b""
        source=self.headers.get("X-Pushbutton-Source") or "normal-use"
        c=self._conn(); start=time.perf_counter(); first=None; usage={}; chars=0
        try:
            c.request("POST",self._path(),body=body,headers=self._headers(len(body))); r=c.getresponse()
            ctype=(r.getheader("Content-Type") or "").lower(); stream="text/event-stream" in ctype
            if stream:
                self._relay_headers(r,stream=True)
                while True:
                    line=r.readline()
                    if not line:break
                    self.wfile.write(line); self.wfile.flush()
                    if not line.startswith(b"data:"):continue
                    d=line[5:].strip()
                    if not d or d==b"[DONE]":continue
                    try:o=json.loads(d)
                    except Exception:continue
                    seen,add,u=content_event(o); chars+=add
                    if seen and first is None:first=time.perf_counter()
                    if u:usage=u
            else:
                data=r.read(); end_read=time.perf_counter()
                try:
                    o=json.loads(data); usage=o.get("usage") or {}; seen,add,_=content_event(o); chars+=add
                    if seen:first=end_read
                except Exception:chars=len(data)
                self.send_response(r.status,r.reason)
                for k,v in r.getheaders():
                    if k.lower() not in HOP and k.lower()!="content-length":self.send_header(k,v)
                self.send_header("Content-Length",str(len(data))); self.send_header("Connection","close"); self.end_headers(); self.wfile.write(data)
            end=time.perf_counter()
            if self.path.endswith("/chat/completions") or self.path.endswith("/completions"):
                try:PROXY.record(start=start,first=first,end=end,usage=usage,req_bytes=len(body),out_chars=chars,status=r.status,source=source)
                except Exception as exc:self.log_message("metric recording skipped: %s",exc)
        except (BrokenPipeError,ConnectionResetError):
            pass
        finally:
            c.close(); self.close_connection=True

    do_PUT=do_POST


def main():
    global PROXY
    ap=argparse.ArgumentParser(prog="pushbutton-proxy")
    ap.add_argument("--upstream",required=True,help="backend base URL, e.g. http://127.0.0.1:20880")
    ap.add_argument("--port",type=int,required=True); ap.add_argument("--host",default="127.0.0.1")
    ap.add_argument("--model",required=True); ap.add_argument("--backend",required=True); ap.add_argument("--artifact")
    ap.add_argument("--context",type=int,default=262144); ap.add_argument("--gpu-model",action="append")
    ap.add_argument("--gpu-memory-mib",type=int,action="append"); ap.add_argument("--ram-gib",type=float); ap.add_argument("--quiet",action="store_true")
    a=ap.parse_args(); PROXY=Proxy(a); server=ThreadingHTTPServer((a.host,a.port),Handler); server.quiet=a.quiet
    print(f"[pushbutton-proxy] profiling normal use on http://{a.host}:{a.port}/v1 -> {a.upstream}",file=sys.stderr,flush=True)
    try:server.serve_forever()
    except KeyboardInterrupt:pass
    finally:server.server_close(); metrics.maybe_upload(force=True)

if __name__=="__main__":main()
