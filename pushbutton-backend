def main() -> int:
    global DRY
    ap = argparse.ArgumentParser(prog="pushbutton-backend")
    ap.add_argument("--dry-run", action="store_true")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list")
    for name in ("check", "prepare", "serve", "fingerprint"):
        p = sub.add_parser(name); p.add_argument("backend"); p.add_argument("model"); p.add_argument("--gpus"); p.add_argument("--force", action="store_true")
        if name in ("serve", "check"):
            p.add_argument("--context", type=int, default=65536)
            p.add_argument("--concurrency", type=int, default=1)
            p.add_argument("--profile")
            p.add_argument("--capacity", help="measured specialized Flash-Next capacity JSON")
        if name == "serve":
            p.add_argument("--port", type=int, default=20880); p.add_argument("--no-prepare", action="store_true")
    args = ap.parse_args(); DRY = args.dry_run
    reg = registry()["backends"]
    if args.cmd == "list":
        for k, v in reg.items(): print(f"{k:24} {v['status']:12} models={','.join(v['models'])}  {v['name']}")
        return 0
    model = canonical_model(args.model); gpus = select_gpus(args.backend, args.gpus); validate(args.backend, model, gpus, args.force)
    capacity = None
    if args.cmd in ("check", "serve"):
        capacity = validate_capacity(args.backend, model, gpus, args.context, args.concurrency, args.profile, args.capacity)
    if args.cmd == "check":
        print(json.dumps({"backend": args.backend, "model": model, "gpus": gpus, "ok": True}, indent=2)); return 0
    if args.cmd == "prepare": prepare(args.backend, model, gpus); return 0
    if args.cmd == "fingerprint":
        info = reg[args.backend].copy(); info.update({"id": args.backend, "model": model, "gpus": gpus, "source_revision": source_revision(args.backend)})
        if args.backend in FLASH_BACKENDS:
            info["artifact"] = FLASH_ARTIFACTS[args.backend]
            info["runtime_revision"] = None if DRY else runtime_revision(args.backend)
        print(json.dumps(info, indent=2)); return 0
    if args.cmd == "serve":
        if not args.no_prepare: prepare(args.backend, model, gpus)
        # Builds/downloads may change free RAM/VRAM. Admission is never bypassed
        # by --force, and is repeated immediately before the engine allocation.
        capacity = validate_capacity(args.backend, model, gpus, args.context, args.concurrency, args.profile, args.capacity)
        serve(args.backend, model, gpus, args.port, args.context, args.profile, args.concurrency, capacity); return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
