}


def say(msg: str) -> None:
    print(f"[pushbutton-backend] {msg}", file=sys.stderr, flush=True)


def shell(cmd: Iterable[str]) -> str:
    return " ".join(shlex.quote(str(x)) for x in cmd)


def run(cmd: list[str], *, cwd: pathlib.Path | None = None, env: dict[str, str] | None = None, capture: bool = False) -> str:
    say(("DRY-RUN " if DRY else "") + shell(cmd))
    if DRY:
        return ""
    cp = subprocess.run(cmd, cwd=cwd, env=env, text=True, check=True, stdout=subprocess.PIPE if capture else None)
    return (cp.stdout or "").strip()


def exec_cmd(cmd: list[str], *, cwd: pathlib.Path | None = None, env: dict[str, str] | None = None) -> None:
    # Docker parses --gpus as CSV even with subprocess argv: a device list must
    # be one quoted CSV field, not separate count/device fields.
    if "--gpus" in cmd:
        pos = cmd.index("--gpus") + 1
        if cmd[pos].startswith("device=") and "," in cmd[pos]:
            cmd = cmd[:pos] + ['"' + cmd[pos] + '"'] + cmd[pos + 1:]
    say(("DRY-RUN exec " if DRY else "exec ") + shell(cmd))
    if DRY:
        return
    if cwd:
        os.chdir(cwd)
    if env is not None:
        os.environ.clear(); os.environ.update(env)
    os.execvp(cmd[0], cmd)


def registry() -> dict:
    return json.loads(REGISTRY_PATH.read_text())


def canonical_model(x: str) -> str:
    x = x.lower().strip()
    aliases = {
        "qwen38": "qwen3.8:27b", "qwen3.8-27b": "qwen3.8:27b", "qwen3.8:27b": "qwen3.8:27b",
        "flash-next": "qwen3.8-flash-next", "qwen3.8-flash-next": "qwen3.8-flash-next", "qwen38-flash-next": "qwen3.8-flash-next",
    }
    return aliases.get(x, x)


def gpu_rows() -> list[dict]:
    if not shutil.which("nvidia-smi"):
        return []
    out = subprocess.check_output([
        "nvidia-smi", "--query-gpu=index,name,memory.total,memory.free,compute_cap",
        "--format=csv,noheader,nounits"
    ], text=True)
    rows = []
    for line in out.splitlines():
        p = [z.strip() for z in line.split(",")]
        if len(p) >= 5:
            rows.append({"index": int(p[0]), "name": p[1], "memory_total_mib": int(float(p[2])), "memory_free_mib": int(float(p[3])), "compute_cap": p[4]})
    return rows


def select_gpus(backend: str, explicit: str | None) -> list[int]:
    if explicit:
        return [int(x) for x in explicit.split(",") if x.strip()]
    need = {"llamampere": 1, "volta-llama": 1, "sglang-v100": 4, "vllm-qwen38-3090": 1, "ninfer-3090": 1, "vllm-flashnext-3090": 4}.get(backend, 1)
    rows = gpu_rows()
    if not rows:
        if DRY:
            return list(range(need))
        raise SystemExit("no NVIDIA GPUs visible; use --gpus only if nvidia-smi is working")
    return [r["index"] for r in rows[:need]]


def validate(backend: str, model: str, gpus: list[int], force: bool) -> None:
    info = registry()["backends"].get(backend)
    if not info:
        raise SystemExit(f"unknown backend {backend!r}; run: pushbutton-backend list")
    if model not in info["models"]:
        raise SystemExit(f"backend {backend} does not currently have a tested adapter for {model}; supported: {', '.join(info['models'])}")
    if not gpus or len(set(gpus)) != len(gpus) or any(g < 0 for g in gpus):
        raise SystemExit("select distinct nonnegative physical GPU indices")
    if backend in FLASH_BACKENDS and len(gpus) != 4:
        raise SystemExit(f"{backend} requires exactly four dedicated GPUs; two-card recipes are unverified")
    if DRY or force:
        return
    rows = {r["index"]: r for r in gpu_rows()}
    missing = [g for g in gpus if g not in rows]
    if missing:
        raise SystemExit(f"GPU index(es) not visible: {missing}")
    caps = {f"sm{rows[g]['compute_cap'].replace('.', '')}" for g in gpus}
    allowed = set(info["gpu_arch"])
    if not caps <= allowed:
        raise SystemExit(f"{backend} is tuned for {sorted(allowed)}, selected GPUs are {sorted(caps)}; use --force only for deliberate experiments")
    minimum = {"sglang-v100": 4, "vllm-flashnext-3090": 4}.get(backend, 1)
    if len(gpus) < minimum:
        raise SystemExit(f"{backend} needs at least {minimum} GPU(s); selected {gpus}")


def validate_capacity(backend, model, gpus, context, concurrency, profile, path):
    """Specialized Flash-Next capacity is measured, never inferred from GGUF size."""
    if context < 1 or not 1 <= concurrency <= 64:
        raise SystemExit("context must be positive and concurrency must be 1..64")
    if backend == "vllm-qwen38-3090" and concurrency != 1:
        raise SystemExit("vllm-qwen38-3090 image has no verified concurrency control; use C1")
    if backend not in FLASH_BACKENDS:
        return None
    lane = profile or "mtp"
    if backend == "vllm-flashnext-3090":
        if lane not in ("mtp", "bf16"):
            raise SystemExit("supported recipe profiles: mtp, bf16; FP8 requires unintegrated patches/scales")
        limit = 65536 if lane == "mtp" else 131072
        if context > limit:
            raise SystemExit(f"{lane} recipe context limit is {limit}; requested {context}")
    elif lane != "mtp":
        raise SystemExit("sglang-v100 currently supports only the MTP recipe")
    if not path:
        if DRY:
            say("UNVERIFIED capacity: dry-run only; live Flash-Next serving requires --capacity")
            return None
        raise SystemExit("live specialized Flash-Next requires calibrated --capacity JSON (RAM, per-GPU VRAM, context/concurrency)")
    data = json.loads(pathlib.Path(path).read_text())
    if not isinstance(data, dict) or data.get("version") != 1 or not isinstance(data.get("placements"), list):
        raise SystemExit("capacity JSON requires version 1 and placements array")
    matches = [e for e in data["placements"] if isinstance(e, dict) and
               (e.get("backend"), e.get("model"), e.get("profile"), e.get("artifact")) ==
               (backend, model, lane, FLASH_ARTIFACTS[backend])]
    for entry in matches:
        for key in ("host_mib", "max_context", "max_concurrency", "cpu_threads"):
            if type(entry.get(key)) is not int or entry[key] < 1:
                raise SystemExit(f"capacity requires positive integer {key}")
        vram = entry.get("gpu_mib")
        if not isinstance(vram, list) or len(vram) != 4 or any(type(v) is not int or v <= 0 for v in vram):
            raise SystemExit("capacity gpu_mib must contain four measured positive per-device envelopes")
        if not isinstance(entry.get("source"), str) or not entry["source"].strip():
            raise SystemExit("capacity requires measurement provenance in source")
        if not isinstance(entry.get("runtime_revision"), str) or not entry["runtime_revision"].strip():
            raise SystemExit("capacity requires the measured runtime_revision (recipe commit or Docker image ID)")
        # The upstream W4A16 recipe CPU-offloads a ~97 GiB BF16 PLE table.
        if backend == "vllm-flashnext-3090" and entry["host_mib"] < 97 * 1024:
            raise SystemExit("W4A16 recipe requires at least 97 GiB host PLE weights plus measured staging/buffers")
        if context > entry["max_context"] or concurrency > entry["max_concurrency"]:
            continue
        if not DRY:
            sys.path.insert(0, str(ROOT / "lib"))
            from claude_local_resources import host_inventory
            host = host_inventory()
            if entry["host_mib"] + host.reserve_mib > host.usable_mib or entry["cpu_threads"] > host.cpu_capacity:
                continue
            rows = {r["index"]: r for r in gpu_rows()}
            arch = set(registry()["backends"][backend]["gpu_arch"])
            fraction = .80 if backend == "sglang-v100" else .97 if lane == "mtp" else .96
            if any(g not in rows or f"sm{rows[g]['compute_cap'].replace('.', '')}" not in arch or
                   rows[g]["memory_free_mib"] < required + 512 or
                   required < math.ceil(rows[g]["memory_total_mib"] * fraction)
                   for g, required in zip(gpus, vram)):
                continue
            if entry["runtime_revision"] != runtime_revision(backend):
                raise SystemExit("capacity runtime revision differs from installed engine; prepare/calibrate again")
        return entry
    raise SystemExit("no verified specialized capacity fits selected GPUs and live host RAM/CPU, context and concurrency")


def runtime_revision(backend):
    if backend == "sglang-v100":
        try:
            return subprocess.check_output(
                docker_prefix() + ["image", "inspect", "--format", "{{.Id}}", FLASH_ARTIFACTS[backend]],
                text=True).strip()
        except subprocess.CalledProcessError:
            return None
    return source_revision(backend)


def ensure_repo(name: str, url: str, ref: str = "main") -> pathlib.Path:
    dst = STATE / "src" / name
    dst.parent.mkdir(parents=True, exist_ok=True)
    if (dst / ".git").exists():
        run(["git", "-C", str(dst), "fetch", "--depth=1", "origin", ref])
        run(["git", "-C", str(dst), "checkout", "-q", "--detach", "FETCH_HEAD"])
    else:
        run(["git", "clone", "--depth=1", "--branch", ref, url, str(dst)])
    return dst


def docker_prefix() -> list[str]:
    if DRY:
        return ["sudo", "docker"]
    probes = (["docker", "info"], ["sudo", "docker", "info"])
    for probe in probes:
        try:
            subprocess.run(probe, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
            return probe[:-1]
        except Exception:
            pass
    raise SystemExit("Docker is required for this backend; install Docker + NVIDIA Container Toolkit (sudo docker is supported)")


def ensure_hf() -> pathlib.Path:
    venv = STATE / "hf"
    hf = venv / "bin" / "hf"
    if hf.exists() or DRY:
        return hf
    run([sys.executable, "-m", "venv", str(venv)])
    run([str(venv / "bin" / "python"), "-m", "pip", "install", "-U", "huggingface_hub[hf_xet]"])
    return hf


def hf_download(repo: str, *, filename: str | None = None, include: str | None = None, local_dir: pathlib.Path | None = None, revision: str | None = None) -> str:
    hf = ensure_hf()
    cmd = [str(hf), "download", repo]
    if filename: cmd.append(filename)
    if include: cmd += ["--include", include]
    if revision: cmd += ["--revision", revision]
    if local_dir:
        local_dir.mkdir(parents=True, exist_ok=True)
        cmd += ["--local-dir", str(local_dir)]
    return run(cmd, capture=local_dir is None)


def find_largest(path: pathlib.Path, glob: str) -> pathlib.Path:
    files = list(path.rglob(glob))
    if not files:
        if DRY:
            return path / "MODEL.gguf"
        raise SystemExit(f"no {glob} found under {path}")
    return max(files, key=lambda p: p.stat().st_size)


def prepare(backend: str, model: str, gpus: list[int]) -> None:
    STATE.mkdir(parents=True, exist_ok=True); CACHE.mkdir(parents=True, exist_ok=True)
    if backend == "llama.cpp":
        src = ensure_repo("llama.cpp-bench", "https://github.com/ggml-org/llama.cpp.git")
        caps = sorted({r["compute_cap"].replace(".", "") for r in gpu_rows() if r["index"] in gpus}) or ["86"]
        build = src / ("build-sm" + "_".join(caps))
        run(["cmake", "-S", str(src), "-B", str(build), "-G", "Ninja", "-DGGML_CUDA=ON", "-DGGML_CUDA_FA_ALL_QUANTS=ON", "-DCMAKE_BUILD_TYPE=Release", f"-DCMAKE_CUDA_ARCHITECTURES={';'.join(caps)}"])
        run(["cmake", "--build", str(build), "--target", "llama-server", "-j", str(os.cpu_count() or 8)])
        return
    if backend == "llamampere":
        src = ensure_repo("llamAmpere", "https://github.com/JakeATX/llamAmpere.git")
        build = src / "build-sm86"
        run(["cmake", "-S", str(src), "-B", str(build), "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DGGML_CUDA=ON", "-DGGML_CUDA_FA=ON", "-DCMAKE_CUDA_ARCHITECTURES=86", "-DGGML_NATIVE=ON"])
        run(["cmake", "--build", str(build), "-j", str(os.cpu_count() or 8), "--target", "llama-server"])
        hf_download("jakeatx/Qwen3.8-27B-ATX-IQ4_XS-M-GGUF", include="*.gguf", local_dir=CACHE / "llamampere-qwen38")
        return
    if backend == "volta-llama":
        src = ensure_repo("volta-llama", "https://github.com/jackjusko/jusko-llama-volta-qwen3flash.git")
        build = src / "build-sm70"
        run(["cmake", "-S", str(src), "-B", str(build), "-G", "Ninja", "-DCMAKE_BUILD_TYPE=Release", "-DGGML_CUDA=ON", "-DCMAKE_CUDA_ARCHITECTURES=70", "-DLLAMA_BUILD_UI=OFF"])
        run(["cmake", "--build", str(build), "-j", str(os.cpu_count() or 8), "--target", "llama-server"])
        hf_download("unsloth/Qwen3.8-27B-GGUF", filename="Qwen3.8-27B-UD-Q5_K_XL.gguf", local_dir=CACHE / "volta-qwen38")
        return
    if backend == "sglang-v100":
        d = docker_prefix(); run(d + ["pull", "geesegeesegeese/sglang-v100:v100-qwen38-flash-next-v4"]); return
    if backend == "vllm-qwen38-3090":
        d = docker_prefix(); run(d + ["pull", "ghcr.io/syv-ai/qwen38-27b-rtx3090:latest"]); return
    if backend == "ninfer-3090":
        src = ensure_repo("ninfer-3090", "https://github.com/Don-Chad/ninfer-3090.git", "master")
        d = docker_prefix(); run(d + ["build", "--tag", "pushbutton-ninfer-3090:sm86", "."], cwd=src)
        model_dir = CACHE / "ninfer-3090"; model_dir.mkdir(parents=True, exist_ok=True)
        env = os.environ.copy(); env["NINFER_MODEL_DIR"] = str(model_dir)
        run(["bash", "scripts/download-qwen38.sh"], cwd=src, env=env)
        return
    if backend == "vllm-flashnext-3090":
        src = ensure_repo("vllm-flashnext-3090", "https://github.com/loktar00/qwen38-flash-next-vllm-3090-recipe.git")
        venv = STATE / "vllm-flashnext-3090-venv"; vsrc = STATE / "vllm-flashnext-3090-src"
        env = os.environ.copy(); env.update({"VENV": str(venv), "SRC": str(vsrc), "TORCH_CUDA_ARCH_LIST": "8.6", "CMAKE_BUILD_TYPE": "Release", "HF_HOME": str(CACHE / "hf-flashnext-3090")})
        env.update({"BASE_SHA": "82399a9fcbebd892d9b2560827a3f8d3e050d2fd",
                    "VLLM_REPO": "https://github.com/vllm-project/vllm", "WITH_FP8KV": "0"})
        run(["bash", "install.sh"], cwd=src, env=env)
        hf_download("VnimanieAI/Qwen3.8-Flash-Next-W4A16", revision="9236d703b25f25eb5c17e9640204f84fa1ce0c6e")
        return
    raise SystemExit(f"prepare not implemented for {backend}")


def source_revision(backend: str) -> str | None:
    paths = {
        "llama.cpp": STATE / "src/llama.cpp-bench", "llamampere": STATE / "src/llamAmpere",
        "volta-llama": STATE / "src/volta-llama", "ninfer-3090": STATE / "src/ninfer-3090",
        "vllm-flashnext-3090": STATE / "src/vllm-flashnext-3090",
    }
    p = paths.get(backend)
    if p and (p / ".git").exists():
        try: return subprocess.check_output(["git", "-C", str(p), "rev-parse", "HEAD"], text=True).strip()
        except Exception: return None
    return None


def llama_build_path(srcname: str, prefix: str = "build-sm") -> pathlib.Path:
    src = STATE / "src" / srcname
    builds = sorted(src.glob(prefix + "*"), key=lambda p: p.stat().st_mtime if p.exists() else 0, reverse=True)
    if not builds:
        return src / (prefix + "86")
    return builds[0]


def serve(backend: str, model: str, gpus: list[int], port: int, context: int, profile: str | None,
          concurrency: int = 1, capacity: dict | None = None) -> None:
    if not DRY:
        from backend_runtime import require_free_port
        require_free_port(port)
    served_model = os.environ.get("PUSHBUTTON_BENCH_MODEL_ID", model)
    gpu_csv = ",".join(map(str, gpus)); env = os.environ.copy(); env["CUDA_VISIBLE_DEVICES"] = gpu_csv
    env["HF_HOME"] = str(CACHE / "huggingface"); env["LLAMA_CACHE"] = str(CACHE)
    if backend == "llama.cpp":
        build = llama_build_path("llama.cpp-bench")
        hf = {"qwen3.8:27b": "unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL",
              "qwen3.8-flash-next": "unsloth/Qwen3.8-Flash-Next-GGUF:UD-IQ4_XS",
              "qwen3-4b-instruct-2507": "unsloth/Qwen3-4B-Instruct-2507-GGUF:Q5_K_M"}[model]
        cmd = [str(build / "bin/llama-server"), "-hf", hf, "--host", "127.0.0.1", "--port", str(port), "-c", str(context * concurrency), "-ngl", "999", "-np", str(concurrency), "--jinja", "--cache-type-k", "q8_0", "--cache-type-v", "q8_0", "-fa", "on", "--fit", "off"]
        if len(gpus) > 1: cmd += ["--split-mode", "layer"]
        if os.environ.get("PUSHBUTTON_BENCH_MODEL_ID"): cmd += ["--alias", served_model]
        exec_cmd(cmd, env=env); return
    if backend == "llamampere":
        src = STATE / "src/llamAmpere"; model_path = find_largest(CACHE / "llamampere-qwen38", "*.gguf")
        env["GGML_Q8_TURBO3_MMA_FUSED"] = "1"
        cmd = [str(src / "build-sm86/bin/llama-server"), "-m", str(model_path), "--host", "127.0.0.1", "--port", str(port), "-c", str(context), "-b", "4096", "-ub", "1024", "-t", "8", "-tb", "8", "-ngl", "99", "-fa", "on", "-ctk", "q8_0", "-ctv", "turbo3", "--parallel", "1", "--jinja", "--fit", "off", "--cache-prompt", "--cache-ram", "8192", "--ctx-checkpoints", "24", "--checkpoint-min-step", "10240", "--spec-type", "draft-mtp", "--spec-draft-n-max", "3", "--spec-draft-p-min", "0", "--spec-draft-type-k", "q8_0", "--spec-draft-type-v", "q8_0", "--spec-draft-vocab-map", str(src / "docs/mtp-vocab/atx_65536.txt")]
        cmd[cmd.index("-c") + 1] = str(context * concurrency)
        cmd[cmd.index("--parallel") + 1] = str(concurrency)
        if os.environ.get("PUSHBUTTON_BENCH_MODEL_ID"): cmd += ["--alias", served_model]
        exec_cmd(cmd, env=env); return
    if backend == "volta-llama":
        src = STATE / "src/volta-llama"; model_path = find_largest(CACHE / "volta-qwen38", "*.gguf")
        env.update({"GGML_CUDA_VOLTA_Q8_FATTN_TC":"1", "GGML_CUDA_VOLTA_Q5_X4":"1", "GGML_CUDA_VOLTA_Q6_W4R4":"1", "GGML_CUDA_QWEN35_MTP_SHORTLIST":str(src / "data/mtp-shortlists/qwen38-27b-exact-131072.i32")})
        cmd = [str(src / "build-sm70/bin/llama-server"), "--model", str(model_path), "--alias", "qwen3.8-27b", "--host", "127.0.0.1", "--port", str(port), "--ctx-size", str(context), "--parallel", "1", "--fit", "off", "--gpu-layers", "63", "--split-mode", "layer", "--flash-attn", "on", "--batch-size", "4096", "--ubatch-size", "1024", "--cache-type-k", "q8_0", "--cache-type-v", "q8_0", "--spec-type", "draft-mtp", "--spec-draft-n-max", "3", "--spec-mtp-defer-prompt", "--jinja"]
        cmd[cmd.index("--ctx-size") + 1] = str(context * concurrency)
        cmd[cmd.index("--parallel") + 1] = str(concurrency)
        cmd[cmd.index("--alias") + 1] = served_model
        exec_cmd(cmd, env=env); return
    if backend == "sglang-v100":
        d = docker_prefix(); cache = CACHE / "huggingface"; cache.mkdir(parents=True, exist_ok=True)
        cmd = d + ["run", "--rm", "--gpus", f"device={gpu_csv}", "--network", "host", "--ipc", "host", "--ulimit", "memlock=-1", "--ulimit", "stack=67108864", "-v", f"{cache}:/root/.cache/huggingface", "-e", "FLASHINFER_DISABLE_VERSION_CHECK=1", "-e", "NCCL_P2P_LEVEL=NVL", "-e", "SGLANG_CUSTOM_ALLREDUCE_ALGO=1stage", "-e", "SGLANG_MAMBA_CONV_DTYPE=float16", "-e", "SGLANG_MAMBA_SSM_DTYPE=float16", "-e", "SGLANG_SM70_FORCE_FP16=1", "-e", "SGLANG_SM70_DENSE_GEMV=1", "-e", "SGLANG_SM70_QWEN_FUSIONS=1", "geesegeesegeese/sglang-v100:v100-qwen38-flash-next-v4", "python", "-m", "sglang.launch_server", "--trust-remote-code", "--model-path", "RadixArk/Qwen3.8-Flash-Next-NVFP4", "--served-model-name", "qwen3.8-flash-next", "--dtype", "float16", "--quantization", "modelopt_fp4", "--reasoning-parser", "auto", "--tool-call-parser", "auto", "--attention-backend", "tilelang_fa_v100", "--linear-attn-prefill-backend", "tilelang", "--linear-attn-decode-backend", "triton", "--kv-cache-dtype", "fp8_e5m2", "--tensor-parallel-size", str(len(gpus)), "--host", "127.0.0.1", "--port", str(port), "--mem-fraction-static", "0.80", "--context-length", str(context), "--max-running-requests", "1", "--chunked-prefill-size", "8192", "--cuda-graph-bs", "1", "--speculative-algorithm", "EAGLE", "--speculative-draft-model-path", "RadixArk/Qwen3.8-Flash-Next-NVFP4", "--speculative-num-steps", "3", "--speculative-eagle-topk", "1", "--speculative-num-draft-tokens", "4"]
        cmd[cmd.index("--max-running-requests") + 1] = str(concurrency)
        cmd[cmd.index("--served-model-name") + 1] = served_model
        # Batch graph sizes above one are not verified by this recipe.
        if concurrency > 1:
            pos = cmd.index("--cuda-graph-bs"); del cmd[pos:pos + 2]
            cmd.append("--disable-cuda-graph")
        if capacity:
            pos = cmd.index("--ipc")
            cmd[pos:pos] = ["--memory", f"{capacity['host_mib']}m", "--memory-swap",
                           f"{capacity['host_mib']}m", "--cpus", str(capacity["cpu_threads"])]
        exec_cmd(cmd); return
