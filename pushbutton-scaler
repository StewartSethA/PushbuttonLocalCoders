#!/usr/bin/env python3
"""Conservative elastic replica scaler for the Pushbutton resident pool.

The scaler never increases in-process concurrency. It reacts to actual broker
queue pressure and may add one C1 replica on a GPU that is unclaimed by another
Pushbutton instance and has enough *currently free* VRAM for a selector-proven
fit plus safety headroom. This keeps memory-tight models harmless.
"""
from __future__ import annotations
import argparse, json, os, pathlib, socket, subprocess, sys, time, urllib.request

ROOT=pathlib.Path(__file__).resolve().parent
sys.path.insert(0,str(ROOT/'lib'))
import claude_local_plan as plan
import pushbutton_policy as policy
import pushbutton_registry as registry_store

STATE=pathlib.Path(os.environ.get('PUSHBUTTON_RUNTIME_STATE',pathlib.Path.home()/'.local/share/pushbutton/runtime'))
REGISTRY=STATE/'instances.json'
CATALOG=ROOT/'configs/model-catalog.json'
SINGLE_GPU_BACKENDS={'llama.cpp','ninfer-3090','vllm-qwen38-3090','llamampere','volta-llama'}
MIN_HEADROOM_MIB=1024
SPECIALIZED_HEADROOM_MIB=3072


def say(s):print('[pushbutton-scaler] '+s,file=sys.stderr,flush=True)
def read_json(p,default):
    try:return json.loads(p.read_text())
    except Exception:return default
def get_json(url,timeout=1.0):
    try:
        with urllib.request.urlopen(url,timeout=timeout) as r:return json.load(r)
    except Exception:return None
def endpoint_ok(endpoint):return bool(get_json(endpoint.rstrip('/')+'/models',.7))
def free_port(start=20880):
    for p in range(start,min(65535,start+1200)):
        s=socket.socket()
        try:s.bind(('127.0.0.1',p));return p
        except OSError:pass
        finally:s.close()
    raise RuntimeError('no free local port')
def catalog():return read_json(CATALOG,{}).get('models',{})
def hf_spec(model,artifact):
    if model in plan.PROFILES:
        for p in plan.PROFILES[model]:
            if p.quant==artifact:return p.hf_spec
    m=catalog().get(model,{})
    if m.get('gguf_repo') and artifact:return f"{m['gguf_repo']}:{artifact}"
    return None

def selector_rows(model,context,gpu):
    cmd=[sys.executable,str(ROOT/'pushbutton-select'),model,'--context',str(context),'--gpu',str(gpu),'--no-interactive','--json']
    try:return json.loads(subprocess.check_output(cmd,text=True,stderr=subprocess.DEVNULL)).get('rows',[])
    except Exception:return []
def registry():return registry_store.load(REGISTRY)
def healthy_used_gpus(obj):
    used=set()
    for x in obj.get('instances',[]):
        if not x.get('healthy',True):continue
        g=x.get('gpu')
        if isinstance(g,int):used.add(g)
        for z in x.get('gpus') or []:
            try:used.add(int(z))
            except Exception:pass
    return used
def match_row(rows,source):
    exact=[];fallback=[]
    for r in rows:
        if r.get('status')!='FIT':continue
        speed=r.get('speed_status') or policy.speed_label(r.get('tg'),measured=r.get('evidence')=='MEASURED')[0]
        if speed in {'SLOW','VERY_SLOW'}:continue
        req=r.get('req')
        # Automatic scale-out needs a memory number; unknown memory stays queued.
        if req is None:continue
        margin=SPECIALIZED_HEADROOM_MIB if r.get('backend')!='llama.cpp' else MIN_HEADROOM_MIB
        if int(r.get('_free_mib') or 0)-int(req)<margin:continue
        fallback.append(r)
        if r.get('backend')==source.get('backend') and r.get('artifact')==source.get('artifact'):exact.append(r)
    return (exact or fallback or [None])[0]
def start_detached(cmd,log):
    log.parent.mkdir(parents=True,exist_ok=True);f=log.open('ab',buffering=0)
    return subprocess.Popen([str(x) for x in cmd],stdout=f,stderr=subprocess.STDOUT,start_new_session=True,env=os.environ.copy())
def wait_endpoint(proc,endpoint,timeout=3600):
    deadline=time.monotonic()+timeout
    while time.monotonic()<deadline:
        if proc.poll() is not None:return False
        if endpoint_ok(endpoint):return True
        time.sleep(1)
    return False

def commission(source,row,gpu):
    model=source['model'];context=int(source.get('max_context') or 65536);backend=row['backend'];artifact=row.get('artifact');port=free_port();endpoint=f'http://127.0.0.1:{port}/v1'
    if backend=='llama.cpp':
        spec=hf_spec(model,artifact)
        if not spec:return False
        cmd=[sys.executable,ROOT/'pushbutton-instance','--hf-spec',spec,'--alias',model,'--port',port,'--context',context,'--parallel',1,'--gpus',gpu]
    elif backend in SINGLE_GPU_BACKENDS-{'llama.cpp'}:
        cmd=[sys.executable,ROOT/'pushbutton-backend','serve',backend,model,'--port',port,'--context',context,'--gpus',gpu]
    else:return False
    log=STATE/'logs'/f'scale-{model.replace(":","-")}-{backend}-gpu{gpu}-{port}.log'
    say(f'queue pressure: commissioning replica {model} / {backend} on spare GPU {gpu}')
    proc=start_detached(cmd,log)
    if not wait_endpoint(proc,endpoint):
        say(f'replica failed; leaving existing queue policy unchanged; inspect {log}')
        return False
    inst={'id':f'{model}-{backend}-{port}','model':model,'aliases':[model],'backend':backend,'artifact':artifact,'endpoint':endpoint,'pid':proc.pid,'max_context':context,'framework_max_concurrency':1,'measured_envelopes':[{'concurrency':1,'max_context':context,'safe':True,'evidence':'PROVEN'}],'tg':row.get('tg'),'tg_measured':row.get('evidence')=='MEASURED','healthy':True,'gpu':gpu,'required_mib':row.get('req'),'scaled_from':source.get('id')}
    registry_store.append_instance(inst,REGISTRY);say(f'replica ready: {endpoint}')
    return True

def _scale_locked(pressured):
    # Re-read all placement facts only after acquiring the same cold-start lock
    # used by `pushbutton`; this prevents scaler/CLI races for apparently-free VRAM.
    obj=registry();by_id={x.get('id'):x for x in obj.get('instances',[])};used=healthy_used_gpus(obj)
    try:gpus=sorted(plan.inventory(),key=lambda g:g.free_mib,reverse=True)
    except Exception:return False
    for p in pressured:
        source=by_id.get(p.get('id'))
        if not source or source.get('backend') not in SINGLE_GPU_BACKENDS:continue
        model=source.get('model');context=int(source.get('max_context') or p.get('context_limit') or 65536)
        for g in gpus:
            if g.index in used:continue
            rows=selector_rows(model,context,g.index)
            for r in rows:r['_free_mib']=g.free_mib
            row=match_row(rows,source)
            if not row:continue
            return commission(source,row,g.index)
    return False

def scale_once(broker):
    st=get_json(broker.rstrip('/')+'/pushbutton/status',1.5)
    if not st:return False
    pressured=sorted([x for x in st.get('instances',[]) if int(x.get('queued') or 0)>0],key=lambda x:-int(x.get('queued') or 0))
    if not pressured:return False
    try:
        with registry_store.named_lock('commission-global',timeout_s=7200):return _scale_locked(pressured)
    except TimeoutError:return False

def main():
    ap=argparse.ArgumentParser(prog='pushbutton-scaler');ap.add_argument('--broker',default='http://127.0.0.1:19780');ap.add_argument('--interval',type=float,default=1.0);ap.add_argument('--once',action='store_true');a=ap.parse_args()
    try:
        with registry_store.named_lock('scaler-singleton',timeout_s=.05,poll_s=.01):
            cooldown=0.0
            while True:
                now=time.monotonic()
                if now>=cooldown and scale_once(a.broker):cooldown=now+10.0
                if a.once:return
                time.sleep(max(.25,a.interval))
    except TimeoutError:
        say('another scaler owns the singleton lock; exiting harmlessly')

if __name__=='__main__':main()
