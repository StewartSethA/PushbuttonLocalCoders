def main():
    ap=argparse.ArgumentParser(prog='pushbutton');ap.add_argument('model',nargs='?');ap.add_argument('--context',type=int);ap.add_argument('--frontend',choices=['qwen','opencode','none']);ap.add_argument('--status',action='store_true');ap.add_argument('--allow-slow',action='store_true');ap.add_argument('--reconfigure',action='store_true');ap.add_argument('--telemetry-on',action='store_true');ap.add_argument('--telemetry-off',action='store_true');ap.add_argument('--telemetry-url')
    for name in ('slots','output','client-context','compact','quant','kv-k','kv-v','min-tps','admission'):
        ap.add_argument('--'+name)
    ap.add_argument('--plan-only',action='store_true')
    argv=sys.argv[1:]
    separator=argv.index('--') if '--' in argv else len(argv)
    a,extra=ap.parse_known_args(argv[:separator])
    a.frontend_args=extra+argv[separator+1:]
    cfg={} if a.reconfigure else read_json(CONFIG,{})
    if a.status:return show_status(cfg)
    try:
        cfg=configure(cfg,a);model=cfg['model'];ctx=int(cfg['context'])
        requested=None;row=None;custom_placement=False
        if model in plan.PROFILES:
            req=worker_plan.parse_model_spec(cfg['model_spec'],cfg.get('models',{}))
            requested=capacity.resolve_options(req.capacity,ctx);ctx=requested['context']
            custom_placement=req.gpu_indices is not None or req.vram_limit_mib is not None or any(k in req.capacity for k in ('slots','quant','kv_k','kv_v'))
            if a.plan_only:
                if custom_placement:
                    proposed,row=capacity_candidate(req,ctx);print(json.dumps(proposed,indent=2))
                else:
                    row=choose_candidate(selector_views(model,ctx),a.allow_slow)
                    if not row:raise ValueError(f'no fitting local configuration found for {model}')
                    print(json.dumps({'model':model,'context':ctx,'selected':automatic_capacity_row(model,req,ctx,row)},indent=2))
                return
        elif '@' in cfg['model_spec'] or cfg.get('models',{}).get(model):
            raise ValueError('per-model capacity options require a supported llama.cpp planner profile')
        elif a.plan_only:
            print(json.dumps({'model':model,'context':ctx,'rows':selector_views(model,ctx)},indent=2));return
    except ValueError as exc:raise SystemExit(str(exc))
    # Global cold-start single-flight prevents simultaneous CLIs from racing the
    # same free VRAM before either backend has had time to allocate it. Recheck
    # the registry after acquiring the lock so followers simply reuse the winner.
    with registry_store.named_lock('commission-global',timeout_s=7200):
        resident=healthy_resident(model,ctx,requested,requested.get('quant') if requested else None,req if requested else None)
        if resident:say(f"reusing {resident['model']} at {resident['endpoint']}")
        else:
            if custom_placement:
                try:
                    proposed,row=capacity_candidate(req,ctx)
                except ValueError as exc:raise SystemExit(str(exc))
                worker=proposed['workers'][0]
                say(f"{model}: slots={requested['slots']}, context/slot={ctx:,}, input={requested['input_tokens']:,}, output={requested['output_tokens']:,}, compact={requested['compact_trigger']:,}; estimated {row['req']:,} MiB, headroom {worker['headroom_mib']:,} MiB")
            if row is None:
                rows=selector_views(model,ctx);row=choose_candidate(rows,a.allow_slow)
            if not row:raise SystemExit(f'no fitting local configuration found for {model} at {ctx:,} context')
            if requested and not custom_placement:
                row=automatic_capacity_row(model,req,ctx,row)
            if requested and not custom_placement:
                resolved=row['capacity']
                say(f"{model}: slots={resolved['slots']}, context/slot={ctx:,}, input={resolved['input_tokens']:,}, output={resolved['output_tokens']:,}, compact={resolved['compact_trigger']:,}; estimated {row.get('req') or '?'} MiB")
            label,msg=policy.speed_label(row.get('tg'),measured=row.get('evidence')=='LOCAL MEASURED')
            if label in {'SLOW','VERY_SLOW'}:warn(msg or f'{model} is expected to decode below {policy.MIN_DECODE_TOK_S:.0f} tok/s')
            say(f"selected {model} / {row['backend']} / {row['artifact']} on GPU {row.get('gpu')} — TG {row.get('tg') or '?'} tok/s ({row.get('evidence')})")
            resident=commission(model,ctx,row)
    broker_port=ensure_broker(cfg);say(f'broker ready: http://127.0.0.1:{broker_port}/v1')
    frontend=cfg.get('frontend','qwen')
    if frontend=='none':print(f'http://127.0.0.1:{broker_port}/v1');return
    extra=list(a.frontend_args);extra=extra[1:] if extra[:1]==['--'] else extra
    budget=resident.get('capacity') or capacity.resolve_budget(ctx)
    if frontend=='opencode':launch_opencode(broker_port,budget['client_context'],extra,model,budget['output_tokens'],budget['input_tokens'],budget['compact_trigger'])
    launch_qwen(broker_port,budget['client_context'],extra,model,budget['output_tokens'],budget['compact_trigger'])

if __name__=='__main__':main()
