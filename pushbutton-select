def adapter_eligibility(metadata,gpus,context,ram_cap):
 constraints=metadata.get('constraints',{})
 if not gpus:return 'UNKNOWN','no GPU inventory; eligibility and memory unknown'
 eligible=[g for g in gpus if 'sm'+g.compute_cap.replace('.','') in metadata['gpu_arch']]
 count=constraints.get('gpu_count',1)
 card=constraints.get('tested_card_mib',0)
 if len(eligible)<count:return 'UNAVAILABLE',f'requires {count} GPUs with architecture {metadata["gpu_arch"]}'
 name=constraints.get('tested_gpu_name','')
 recipe_cards=[g for g in eligible if g.total_mib>=card and name.lower() in g.name.lower()]
 if len(recipe_cards)<count:
  return 'UNAVAILABLE','published GPU model/card capacity configuration unavailable; smaller-card fit is not proven'
 if context>constraints.get('max_context',context):
  return 'UNAVAILABLE','context exceeds this adapter profile limit'
 return 'UNKNOWN',f'architecture eligible, but free VRAM/topology/calibration/runtime must be validated; host RAM minimum unknown; constraints={json.dumps(constraints)}'

CODER_FRONTENDS=('qwen-local','coder-local','opencode-local','deepseek-local','mini-swe-local')
FRONTENDS=CODER_FRONTENDS+('claude-local','hermes-local')

def joint_preview(models,frontend,agents,gpus,context,cap=None,gpu_indices=None,placement_config=None,slots=1,client_context=None):
 if context<1:raise ValueError('context must be positive')
 if not gpus:raise ValueError('No supported NVIDIA GPUs detected; no provisioning attempted.')
 supported=json.loads((ROOT/'configs/backend-registry.json').read_text())['backends']['llama.cpp']['gpu_arch']
 unsupported=[g for g in gpus if 'sm'+g.compute_cap.replace('.','') not in supported]
 gpus=[g for g in gpus if g not in unsupported]
 if not gpus:
  raise ValueError('GPU architecture is unknown or unsupported by the baseline registry; no provisioning attempted.')
 if frontend in CODER_FRONTENDS:
  defaults=workers.load_placement_config(placement_config or workers.DEFAULT_PLACEMENT_CONFIG)
  requests=[workers.parse_model_spec(m,defaults) for m in models]
  requests=[replace(r,gpu_indices=r.gpu_indices if r.gpu_indices is not None else gpu_indices,
                    vram_limit_mib=r.vram_limit_mib if r.vram_limit_mib is not None else cap) for r in requests]
  result=workers.build_plan(requests,agents,gpus,context,slots,client_context)
  # Pin each independent worker to its previewed GPU set and lease.
  launch_models=[]
  for w in result['workers']:
   spec=w['model']+'@gpu='+w['cuda_visible_devices'].replace(',','+')
   if w['vram_limit_mib_per_gpu'] is not None:spec+=f",vram={w['vram_limit_mib_per_gpu']}MiB"
   # Carry the exact capacity/precision plan into the launcher's replan.
   c=w['capacity']
   spec+=f",context={c['context']},slots={c['slots']},output={c['output_tokens']},client_context={c['client_context']},compact={c['compact_trigger']},safety={c['safety_tokens']},kv_k={w['profile']['kv_k']},kv_v={w['profile']['kv_v']}"
   if c.get('min_tps') is not None:spec+=f",min_tps={c['min_tps']}"
   if c.get('admission_explicit',True):spec+=f",admission={c['admission_limit']}"
   if c.get('bits') is not None:spec+=f",bits={c['bits']}"
   spec+=f",quant={w['profile']['quant']}"
   launch_models.append(spec)
 else:
  if agents is not None and frontend!='claude-local':
   raise ValueError('Hermes does not support independent --agents replicas')
  if cap is not None or gpu_indices is not None:
   raise ValueError('GPU pins/leases are supported by coder frontends only; Claude/Hermes use their role planner')
  launch_models=[canon(m.split('@',1)[0])+('@'+m.split('@',1)[1] if '@' in m else '') for m in models]
  result=plan.plan(launch_models,gpus,context,slots,client_context=client_context,agents=agents)
  if agents is not None:
   launch_models=[launch_models[min(i,len(launch_models)-1)] for i in range(len(result['servers']))]
 result['unused_gpus'] += [asdict(g) for g in unsupported]
 return result,launch_models

def launch_command(frontend,models,result,context,client_context,launch_args,slots=1):
 # The wrapper supplies an argv list; only recognized launchers are executable.
 target=ROOT/frontend
 if frontend=='claude-local':target=ROOT/'lib/claude_local_entry.sh'
 if frontend=='coder-local':target=ROOT/'coder-local'
 command=['bash',str(target)] if frontend=='claude-local' else [str(target)]
 if frontend=='coder-local':command+=['--frontend','qwen']
 command+=models
 if frontend in CODER_FRONTENDS:command+=['--agents',str(result['agents'])]
 command+=['--local-context',str(context)]
 if client_context is not None:command+=['--local-client-context',str(client_context)]
 if slots!=1:command+=['--slots',str(slots)]
 command+=launch_args
 return command

def welcome(ap):
 while True:
  print('\nWelcome to Pushbutton Local Coders — nothing is provisioned until you confirm.')
  print('  1. Choose model(s) and launch\n  2. Inspect models / hardware / Flash-Next backends\n  3. Preview a plan (no launch)\n  4. Help\n  5. Quit')
  action=input('Action [4]: ').strip() or '4'
  if action in ('1','2','3'):return action
  if action=='4':ap.print_help()
  elif action in ('5','q','quit'):return '5'
  else:print('Please choose 1–5.')

def positive_input(prompt,default,maximum=None):
 while True:
  try:
   value=int(input(f'{prompt} [{default}]: ').strip() or default)
   if value>0 and (maximum is None or value<=maximum):return value
  except ValueError:pass
  print('Please enter a positive number'+(f' up to {maximum}.' if maximum else '.'))

def main():
 ap=argparse.ArgumentParser(prog='pushbutton-select')
