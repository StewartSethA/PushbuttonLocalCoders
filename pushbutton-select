def benchmark_hint(model,short=False):
 m=catalog().get(model,{})
 b=m.get('benchmarks') or {}
 order=['Terminal-Bench 2.1 (Claude Code)','Terminal-Bench 2.1','SWE-bench Verified','SWE-bench Pro','DeepSWE v1.1','DeepSWE','NL2Repo-Bench','NL2Repo','GPQA Diamond']
 parts=[]
 for name in order:
  if name not in b:continue
  label=name.replace('Terminal-Bench 2.1 (Claude Code)','TB2.1-CC').replace('Terminal-Bench 2.1','TB2.1').replace('SWE-bench Verified','SWE-V').replace('SWE-bench Pro','SWE-Pro').replace('DeepSWE v1.1','DeepSWE').replace('NL2Repo-Bench','NL2Repo').replace('GPQA Diamond','GPQA')
  parts.append(f"{label} {b[name].get('score')}")
  if short and len(parts)>=2:break
 return ' | '.join(parts)

