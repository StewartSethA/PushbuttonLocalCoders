 print('\nResource ceilings: VRAM lease is per GPU, capped by currently free memory.')
 while True:
  try:
   rs=input(f'Advisory host RAM ceiling [{fmt_mib(avail)} available]: ').strip()
   vs=input('Per-GPU VRAM lease [auto = currently free VRAM]: ').strip()
   ram_cap=parse_mem(rs) if rs else avail
   cap=workers.parse_memory_mib(vs)
   if ram_cap is not None and ram_cap<=0:raise ValueError('RAM ceiling must be positive')
   return ram_cap,cap
  except ValueError as exc:print(exc)

def measured_summary(model,backend,gpu_name,context,artifact=None):
 rows=metrics.observations(model,backend,artifact=artifact,gpu_name=gpu_name,context=context)
 # Do not mix published reference samples into local measurements.
 local=[r for r in rows if r.get('evidence_origin')=='local' and r.get('context')==context and gpu_name]
 rows=local or [r for r in rows if r.get('evidence_origin')!='local']
 s=metrics.summarize_observations(rows)
 return rows,s

def evidence_label(obs,sm):
 if not sm.get('pp') and not sm.get('tg'):return 'UNKNOWN'
 return 'LOCAL MEASURED' if obs and all(r.get('evidence_origin')=='local' for r in obs) else 'UPSTREAM REFERENCE'

def selector_model(text):
 name=canon(text)
 if name in catalog():return name
 return workers.parse_model_spec(text).model

def catalog_rows(model,gpu,capacity,ram_cap,context):
 m=catalog().get(model,{})
 rows=[];gpu_name=gpu.name if gpu else None
 for q in m.get('quants') or []:
  weight=float(q['weight_gib'])*1024
  scale=max(.125,min(1.0,context/max(1,int(m.get('context') or 262144))))
  ctx_overhead=(5120 if '9b' in model else 9216)*scale
  req=int(weight+ctx_overhead+1536);ram_req=max(2048,int(weight*.15))
  status='UNKNOWN' if capacity is None else ('FIT' if req<=capacity else 'BLOCK')
  if ram_cap is not None and ram_req>ram_cap:status='BLOCK'
  obs,sm=measured_summary(model,'llama.cpp',gpu_name,context,q['name'])
  rows.append({'model':model,'backend':'llama.cpp','artifact':q['name'],'req':req,'ram_req':ram_req,'quality':str(q.get('quality','n/a')),'pp':(sm.get('pp') or {}).get('median'),'tg':(sm.get('tg') or {}).get('median'),'status':status,'note':f"{m.get('gguf_repo')} — estimated memory envelope, not a joint frontend planner profile",'evidence':evidence_label(obs,sm),'spread':sm})
 if model=='deepseek-v4.1-flash':
  req=int(float(m.get('minimum_vram_gib',614))*1024)
  rows.append({'model':model,'backend':'vllm','artifact':'native mixed MXFP4/MXFP8','req':req,'ram_req':32768,'quality':'native','pp':None,'tg':None,'status':'BLOCK' if capacity is not None and capacity<req else 'UNVERIFIED','note':'vLLM 0.30+ dedicated DeepSeek V4.1 image; 614 GB aggregate VRAM reference, no automatic local launcher','evidence':'UNKNOWN','spread':{}})
 elif model=='ornith-1.5:397b' and not m.get('quants'):
  rows.append({'model':model,'backend':'vllm/llama.cpp','artifact':'397B checkpoint / GGUF','req':None,'ram_req':None,'quality':'native','pp':None,'tg':None,'status':'UNVERIFIED','note':'large-node model; exact local quant/memory profile must be measured before automatic launch','evidence':'UNKNOWN','spread':{}})
 return rows

def rows_for(model,gpu,cap,ram_cap,context,gpus=None,request=None,slots=1):
 rows=[]; gpu_name=gpu.name if gpu else None
 gpus=gpus if gpus is not None else ([gpu] if gpu else [])
 request=request or workers.WorkerRequest(model)
 settings=capacity_settings.resolve_options(request.capacity,context,slots)
 context=settings['context']
 if request.vram_limit_mib is not None:cap=request.vram_limit_mib
 if request.gpu_indices is not None:gpus=[g for g in gpus if g.index in request.gpu_indices]
 effective=[replace(g,free_mib=min(g.free_mib,cap)) if cap is not None else g for g in gpus]
 registry=json.loads((ROOT/'configs/backend-registry.json').read_text())['backends']
 baseline_gpus=[g for g in effective if 'sm'+g.compute_cap.replace('.','') in registry['llama.cpp']['gpu_arch']]
 capacity=sum(g.free_mib for g in baseline_gpus)
 if model in plan.PROFILES:
  fitting=workers.candidates_for_request(replace(request,vram_limit_mib=cap),baseline_gpus,context,slots,quality_filter=False) if baseline_gpus else []
  fitting_quants={c.profile.quant for c in fitting}
  for p in plan.PROFILES[model]:
   note='baseline; conservative VRAM planning envelope, not measured allocation; host RAM minimum unknown; '+p.note
   try:
    resolved=workers.request_capacity(request,p,context,slots)
    req=resolved['memory_estimate']['required_mib']
    status=('FIT' if p.quant in fitting_quants else 'BLOCK') if baseline_gpus else ('UNAVAILABLE' if effective else 'UNKNOWN')
   except ValueError as error:
    resolved=settings;req=None;status='UNAVAILABLE';note+='; '+str(error)
   if not capacity_settings.matches_quant(p.quant,settings):
    status='UNAVAILABLE';note+='; excluded by requested quant/bits'
   obs,sm=measured_summary(model,'llama.cpp',gpu_name,context,p.quant)
   if settings['slots']!=1 or settings.get('kv_k',p.kv_k)!=p.kv_k or settings.get('kv_v',p.kv_v)!=p.kv_v:
    obs=[];sm={};note+='; no matching slot/cache throughput evidence'
   pp=(sm.get('pp') or {}).get('median'); tg=(sm.get('tg') or {}).get('median')
   rows.append({'model':model,'backend':'llama.cpp','artifact':p.quant,'req':req,'ram_req':None,'quality':str(p.quality),'pp':pp,'tg':tg,'status':status,'note':note,'evidence':evidence_label(obs,sm),'spread':sm,'capacity':resolved})
 if model not in plan.PROFILES:rows+=catalog_rows(model,gpu,capacity if baseline_gpus else None,ram_cap,context)
 for (m,b),d in UPSTREAM.items():
  if m!=model:continue
  hard=d.get('hard_min_mib'); tested=d.get('tested_card_mib'); ram_req=d.get('host_ram_mib')
  if cap is None:status='UNVERIFIED'
  elif hard is not None and hard>cap:status='BLOCK'
  elif tested is not None and cap>=tested:status='UNVERIFIED'
  else:status='UNVERIFIED'
  if ram_cap is not None and ram_req is not None and ram_req>ram_cap:status='BLOCK'
  eligibility,_=adapter_eligibility(registry[b],effective,context,ram_cap)
  if eligibility=='UNAVAILABLE':status=eligibility
  obs,sm=measured_summary(model,b,gpu_name,context)
  pp=(sm.get('pp') or {}).get('median'); tg=(sm.get('tg') or {}).get('median')
  evidence=evidence_label(obs,sm)
  rows.append({'model':model,'backend':b,'artifact':d['artifact'],'req':hard,'ram_req':ram_req,'quality':d.get('quality','n/a'),'pp':pp,'tg':tg,'status':status,'note':d['note'],'evidence':evidence,'spread':sm,'local':any(r.get('evidence_origin')=='local' for r in obs)})
 for backend,d in registry.items():
  if model not in d['models'] or backend=='llama.cpp' or (model,backend) in UPSTREAM:continue
  status,note=adapter_eligibility(d,effective,context,ram_cap)
  obs,sm=measured_summary(model,backend,gpu_name,context)
  rows.append({'model':model,'backend':backend,'artifact':d.get('artifact','recipe-specific'),'req':None,'ram_req':None,'quality':'n/a','pp':(sm.get('pp') or {}).get('median'),'tg':(sm.get('tg') or {}).get('median'),'status':status,'note':f"experimental; {note}; {d['notes']} Source: {d['source']}",'evidence':evidence_label(obs,sm),'spread':sm})
 for r in rows:
  r.setdefault('capacity',settings)
  if r['backend']=='llama.cpp' and model not in plan.PROFILES and (settings['slots']!=1 or any(k in settings for k in ('kv_k','kv_v','quant','bits'))):
   r.update(status='UNAVAILABLE',req=None,pp=None,tg=None,evidence='UNKNOWN',spread={})
   r['note']+='; no planner capacity profile for requested slots/quant/cache overrides'
  if r['backend']!='llama.cpp' and (settings['slots']!=1 or any(k in settings for k in ('kv_k','kv_v','quant','bits'))):
   r.update(status='UNAVAILABLE',pp=None,tg=None,evidence='UNKNOWN',spread={})
   r['note']+='; requested slots/quant/cache overrides are unsupported by this adapter'
  metadata=registry.get(r['backend'],{})
  r['support']=metadata.get('status','catalogued')
  r['frontend_integrated']=r['backend']=='llama.cpp' and model in plan.PROFILES
  r['constraints']=metadata.get('constraints',{})
  if r['backend']!='llama.cpp' and metadata:
   eligible=[g for g in gpus if 'sm'+g.compute_cap.replace('.','') in metadata['gpu_arch']]
   command=[str(ROOT/'pushbutton-bench'),model,'--backend',r['backend'],'--context',str(min(context,r['constraints'].get('max_context',context))),'--suite','standard']
   if eligible:command+=['--gpus',','.join(str(g.index) for g in eligible[:r['constraints'].get('gpu_count',1)])]
   r['validation_argv']=command
  s,w=policy.speed_label(r.get('tg'),measured=r['evidence']=='LOCAL MEASURED')
  r['speed_status']=s;r['speed_warning']=w
 rank={'FIT':0,'UNKNOWN':1,'UNVERIFIED':1,'UNAVAILABLE':2,'BLOCK':2}
 sr={'OK':0,'UNKNOWN':1,'SLOW':2,'VERY_SLOW':3}
 rows.sort(key=lambda r:(rank[r['status']],sr.get(r['speed_status'],4),-(int(r['quality']) if str(r['quality']).isdigit() else -1)))
 return rows

def fmt_mib(v):return '-' if v is None else f'{v/1024:.1f}G'
def fmt_rate(v):return '-' if v is None else f'{v:.0f}'
def ev_label(r):
 s=r['evidence']
 return color(s,GREEN) if s=='LOCAL MEASURED' else s

def speed_label(r):
 s=r.get('speed_status','UNKNOWN')
 if s=='OK':return color(s,GREEN)
 if s in {'SLOW','VERY_SLOW'}:return color(s,RED)
 return color(s,YELLOW)
def print_hw(gpu,ram_cap,vram_cap):
 total,avail=ram_info();print('')
 if gpu:
  used=max(0,gpu.total_mib-gpu.free_mib)
  print(f"GPU {gpu.index}: {gpu.name}  {gpu.free_mib/1024:.1f}G free / {gpu.total_mib/1024:.1f}G total  ({used/1024:.1f}G occupied)")
  if vram_cap and vram_cap>gpu.free_mib: print(color(f'WARNING: requested VRAM ceiling {fmt_mib(vram_cap)} exceeds currently free VRAM {fmt_mib(gpu.free_mib)}.',YELLOW),file=sys.stderr)
 if total: print(f'Host RAM: {avail/1024:.1f}G available / {total/1024:.1f}G total  planning ceiling={fmt_mib(ram_cap)}')

