#!/usr/bin/env bash
# qwen-local — robust Qwen Code entrypoint for coder-local.
#
# Current llama.cpp `-hf user/repo:quant` requires HTTPS support.  Do not depend
# on host OpenSSL development headers: rewrite coder-local's CMake configure to
# use the same bundled BoringSSL path used by llama.cpp release builds.  Existing
# builds made before this wrapper are rebuilt once; subsequent runs reuse them.
set -euo pipefail
SELF="${BASH_SOURCE[0]}"
command -v readlink >/dev/null 2>&1 && SELF="$(readlink -f "$SELF" 2>/dev/null || printf '%s' "$SELF")"
ROOT="$(cd "$(dirname "$SELF")" && pwd)"
STATE_DIR="${CLAUDE_LOCAL_STATE:-$HOME/.local/share/pushbutton/claude-local}"

# The wrapper is also useful when invoked directly from a checkout.  coder-local
# still owns CUDA/toolchain detection, model planning, downloads, and launch.
real_cmake="$(command -v cmake || true)"
[[ -n "$real_cmake" ]] || { echo "qwen-local: cmake is required" >&2; exit 1; }

cmake() {
  local -a rewritten=()
  local arg
  for arg in "$@"; do
    if [[ "$arg" == "-DLLAMA_OPENSSL=ON" ]]; then
      rewritten+=("-DLLAMA_OPENSSL=OFF" "-DLLAMA_BUILD_BORINGSSL=ON" "-DLLAMA_BUILD_UI=OFF")
    else
      rewritten+=("$arg")
    fi
  done
  command "$real_cmake" "${rewritten[@]}"
}
export -f cmake
export real_cmake

# If every existing CUDA build predates the bundled-HTTPS configuration, force
# coder-local through its normal update/configure/build path once.  CMake's
# incremental build keeps this cheap after the first repair.
https_build=0
shopt -s nullglob
for cache in "$STATE_DIR"/llama.cpp/build-cuda-*/CMakeCache.txt; do
  build="${cache%/CMakeCache.txt}"
  if [[ -x "$build/bin/llama-server" ]] && grep -q '^LLAMA_BUILD_BORINGSSL:BOOL=ON$' "$cache"; then
    https_build=1
    break
  fi
done
shopt -u nullglob
if (( ! https_build )); then
  export CLAUDE_LOCAL_REBUILD=1
  printf '\033[1;36m[qwen-local]\033[0m repairing/building llama.cpp with bundled HTTPS support (one-time)\n' >&2
fi

exec "$ROOT/coder-local" --frontend qwen "$@"
